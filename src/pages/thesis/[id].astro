---
export async function getStaticPaths() {
  // Pages are dynamic per-thesis; we fetch all ids at request time instead
  return [];
}
export const prerender = false;
const { id } = Astro.params;
let r = {}, sources = [], verdicts = [];
try {
  const db = Astro.locals.runtime.env.DB;
  const q = async (sql, bind) => (await db.prepare(sql).bind(...(bind||[])).all()).results;
  const rows = await q('SELECT * FROM rejected WHERE id = ?', [id]);
  r = rows[0] || {};
  sources = await q('SELECT url, fact FROM sources WHERE rejected_id = ?', [id]);
  verdicts = await q('SELECT model, verdict, confidence, generation_id, cost_usd, reasoning FROM council_verdicts WHERE rejected_id = ?', [id]);
} catch (e) { console.error(e); }
const money = (n) => n==null ? '—' : '$' + Number(n).toFixed(4);
---
<html><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{r.thesis || 'Thesis'} — Cash Machine</title>
<style>
body{font-family:-apple-system,system-ui,sans-serif;background:#0e1117;color:#e6e6e6;margin:0;padding:24px;max-width:860px;margin-inline:auto}
h1{font-size:1.35rem;font-weight:600;line-height:1.35} h2{font-size:1rem;color:#9ca3af;margin-top:30px;margin-bottom:8px}
a{color:#93c5fd;text-decoration:none} a:hover{text-decoration:underline}
nav{margin-bottom:14px;font-size:.9rem}
.muted{color:#6b7280;font-size:.85rem}
.meta{display:flex;gap:14px;flex-wrap:wrap;margin-top:14px}
.meta .item{background:#161b22;border:1px solid #2a2f3a;border-radius:10px;padding:12px 16px}
.meta .l{font-size:.68rem;color:#9ca3af;text-transform:uppercase;letter-spacing:.06em}
.meta .v{font-size:1.15rem;font-weight:600;margin-top:4px}
table{width:100%;border-collapse:collapse;font-size:.88rem;margin-top:8px}
th{color:#9ca3af;text-align:left;font-weight:500;font-size:.72rem;text-transform:uppercase;padding:6px 8px;border-bottom:1px solid #2a2f3a}
td{padding:9px 8px;border-bottom:1px solid #1c2029;vertical-align:top}
.badge{display:inline-block;border-radius:6px;padding:2px 10px;font-size:.78rem;background:#3b2424;color:#f87171}
p.reason{background:#161b22;border:1px solid #2a2f3a;border-radius:10px;padding:14px 16px;line-height:1.55}
</style></head><body>
<nav><a href="/">← Home</a></nav>
<h1>{r.thesis} <span class="badge">{r.decision}</span></h1>
<div class="meta">
  <div class="item"><div class="l">Side</div><div class="v">{r.side || '—'}</div></div>
  <div class="item"><div class="l">My estimate</div><div class="v">{r.my_est_yes || '—'}</div></div>
  <div class="item"><div class="l">Proposed price</div><div class="v">{r.proposed_price!=null?(Number(r.proposed_price)*100).toFixed(1)+'%':'—'}</div></div>
  <div class="item"><div class="l">Market price</div><div class="v">{r.market_price_yes!=null?(Number(r.market_price_yes)*100).toFixed(1)+'%':'—'}</div></div>
  <div class="item"><div class="l">Date</div><div class="v">{(r.ts_utc||'').slice(0,10)}</div></div>
</div>

{r.reason && <><h2>Reasoning</h2><p class="reason">{r.reason}</p></>}
{r.lesson && <><h2>Lesson</h2><p class="reason">{r.lesson}</p></>}

<h2>Evidence sources</h2>
{sources.length === 0 ? <p class="muted">No sources recorded</p> :
<table><tr><th>Fact</th><th>Source</th></tr>
{sources.map(s=>(<tr><td>{s.fact}</td><td><a href={s.url} target="_blank" rel="noopener">{s.url?.replace(/^https?:\/\//,'').slice(0,55)}…</a></td></tr>))}
</table>}

<h2>Council verdicts</h2>
{verdicts.length === 0 ? <p class="muted">No council record</p> :
<table><tr><th>Model</th><th>Verdict</th><th>Conf</th><th>Cost</th><th>Generation</th></tr>
{verdicts.map(v=>(<tr>
 <td>{v.model}</td><td>{v.verdict?.slice?.(0,30)}</td><td>{v.confidence ?? '—'}</td>
 <td>{money(v.cost_usd)}</td>
 <td class="muted"><code>{(v.generation_id||'').slice(0,24)}</code></td>
</tr>))}
</table>}
</body></html>
---
export const prerender = false;
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import '../../styles/global.css';
import { fmtDate, fmtAgo } from '../../lib/dates.js';
import Icon from '../../components/Icon.astro';
let db_error = false;
Astro.response.headers.set('Cache-Control', 'no-store');
const { id } = Astro.params;
// Trade ids live at /trade/<id>/ — if someone hits /thesis/<trade-id>/, redirect.
if (/^T[-0-9]/.test(id) && /^T\d{0,2}-/.test(id)) {
  return Astro.redirect(`/trade/${id}/`, 301);
}
let kf = [];
const isHash = (s) => /0x[0-9a-f]{16,}/i.test(s || '');
let r = {}, sources = [], verdicts = [];
try {
  const db = Astro.locals.runtime.env.DB;
  const q = async (sql, bind) => (await db.prepare(sql).bind(...(bind||[])).all()).results;
  const rows = await q('SELECT * FROM rejected WHERE id = ?', [id]);
  r = rows[0] || {};
  sources = await q('SELECT url, fact FROM sources WHERE rejected_id = ?', [id]);
  verdicts = await q('SELECT model, verdict, confidence, generation_id, cost_usd, reasoning FROM council_verdicts WHERE rejected_id = ?', [id]);
  if (verdicts.length === 0 && r.council_verdicts) {
    try { const inl = typeof r.council_verdicts === 'string' ? JSON.parse(r.council_verdicts) : r.council_verdicts;
      verdicts = (Array.isArray(inl) ? inl : (inl.verdicts || [])).map(v => ({model: v.model, verdict: v.verdict, confidence: v.confidence, cost_usd: v.cost, reasoning: v.reasoning, generation_id: null}));
    } catch {}
  }
} catch (e) {
  db_error = true;
}
try { kf = r.key_figures ? JSON.parse(r.key_figures) : []; } catch {}
const money = (n) => n==null ? '—' : '$' + Number(n).toFixed(4);
const slugTitle = (url, fallback) => {
  try {
    let slug = (url || '').split('/event/')[1] || '';
    slug = slug.replace(/-[0-9a-f]{4,}$/,'');
    if(!slug) return fallback;
    let words = slug.split('-').map(w=>{
      if(/^(by|of|in|the|a|an|on|for|and|or|to|at|its|their|from|between|after|before)$/i.test(w)) return w.toLowerCase();
      if(/^(us|uk|dc|gdp|ipo|er|wti|sep|oct|nov|hr|eu)$/i.test(w)) return w.toUpperCase();
      if(/^\d+$/.test(w)) return w;
      return w.charAt(0).toUpperCase()+w.slice(1);
    });
    let out = words.join(' ').replace(/\s*Byptptpt\s*/i,' ').replace(/\s+(by|into|in|of|for)$/,'');
    out = out.replace(/\s+/g,' ').trim();
    return out.charAt(0).toUpperCase()+out.slice(1);
  } catch { return fallback; }
};
const title = slugTitle(r.market_url, r.thesis || 'Thesis');
const modelName = (m) => (m || '').replace(/^openai\//, '').replace(/^anthropic\//, '').replace(/^moonshotai\//, '');
---
<html>
<head>
<meta charset="utf-8"/>
<script is:inline>
(function(){
  try {
    var pref = new URLSearchParams(location.search).get('theme') || localStorage.getItem('cm-theme') || 'auto';
    var dark = pref === 'dark' || (pref === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
  } catch(e) {}
})();
</script>
<style is:global>
:root{--pos:#0f8a3d;--neg:#d64545}
html[data-theme=dark]{
  --bg:#101013;--fg:#e6e6e9;--mut:#8b8b92;--hair:#26262b;--accent:#8b8bf5;
  --pos:#3fbf6e;--neg:#e56060;
}
html[data-theme=dark] body{background:var(--bg)}
.theme-t{background:none;border:1px solid var(--hair);border-radius:6px;color:var(--mut);
  font:inherit;font-size:.72rem;padding:3px 9px;cursor:pointer;letter-spacing:.03em}
.theme-t:hover{color:var(--fg);border-color:var(--mut)}
</style>

<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title} — Cash Machine</title>
<style is:global>.badge{display:inline-block;border:1px solid var(--hair);border-radius:4px;padding:1px 8px;font-size:.7rem;color:var(--mut);letter-spacing:.04em;text-transform:uppercase;margin-left:10px;vertical-align:middle}
ul.kf{margin:10px 0 0;padding-left:18px;font-size:.9rem}
ul.kf li{margin:4px 0}
.src{padding:9px 0;border-bottom:1px solid var(--hair);font-size:.85rem}
.src:last-child{border-bottom:1px solid var(--hair)}
.src .fact{color:var(--mut);font-size:.8rem;margin-top:2px}
.verdict{display:flex;align-items:baseline;gap:12px;padding:11px 0;border-bottom:1px solid var(--hair);font-size:.88rem}
.verdict:last-child{border-bottom:1px solid var(--hair)}
.reason{border-left:2px solid var(--hair);padding:2px 0 2px 14px;font-family:var(--serif);font-size:1.02rem;line-height:1.6;white-space:pre-wrap}
.k{gap:4px}</style>
</head>
<body>
<div class="wrap">
{db_error && <div class="err">Ledger unreachable — figures may be incomplete.</div>}

<SiteNav />

<header>
  <h1>{title}</h1>
<p class="mut" style="margin:6px 0 0"><span class="badge">{r.decision}</span></p>
  {r.market_url && <p class="mut"><a href={r.market_url} target="_blank" rel="noopener">View market on Polymarket →</a></p>}
</header>

<div class="statline">
  <div class="stat"><div class="v">{r.side || '—'}</div><div class="k"><Icon name="scale" size=11 /> side</div></div>
  <div class="stat"><div class="v">{(r.my_est_yes ?? '') === '' || isNaN(Number(r.my_est_yes)) ? '—' : (Number(r.my_est_yes)*100).toFixed(0)+'%'}</div><div class="k"><Icon name="brain" size={11} /> our estimate</div></div>
  <div class="stat"><div class="v">{r.proposed_price!=null?(Number(r.proposed_price)*100).toFixed(0)+'%':'—'}</div><div class="k"><Icon name="lightbulb" size=11 /> proposed</div></div>
  <div class="stat"><div class="v">{r.market_price_yes!=null?(Number(r.market_price_yes)*100).toFixed(0)+'%':'—'}</div><div class="k"><Icon name="store" size=11 /> market</div></div>
  <div class="stat"><div class="v">{fmtAgo(r.ts_utc)}</div><div class="k"><Icon name="calendar" size=11 /> date</div></div>
</div>

{r.reason && <section><h2><Icon name="message-square-quote" size=12 cls="h2ic" />Reasoning</h2><p class="reason">{r.reason}</p></section>}
{r.lesson && <section><h2><Icon name="graduation-cap" size=12 cls="h2ic" />Lesson</h2><p class="reason">{r.lesson}</p></section>}
{kf.length > 0 && <section><h2><Icon name="sigma" size=12 cls="h2ic" />Key figures</h2><ul class="kf">{kf.map((f,i) => <li>{typeof f === 'string' ? f : (f.fact || f.market || (typeof f === 'number' ? String(f) : Object.entries(f).map(([k2,v2]) => k2+': '+String(v2)).join(' · ')))}</li>)}</ul></section>}

<section>
<h2><Icon name="book-open" size=12 cls="h2ic" />Evidence sources</h2>
{sources.length === 0 ? <p class="mut">No sources recorded</p> :
<div class="rows">
{sources.filter(s=>!isHash(s.url)).map(s=>(<div class="src"><a href={s.url} target="_blank" rel="noopener">{s.url?.replace(/^https?:\/\//,'').slice(0,60)}</a>{s.fact && <div class="fact">{s.fact}</div>}</div>))}
</div>}
</section>

<section>
<h2><Icon name="users" size=12 cls="h2ic" />Council verdicts</h2>
{verdicts.length === 0 ? <p class="mut">No council record</p> :
<div class="rows">
{verdicts.map(v=>(<div class="verdict">
  <span class={v.verdict === 'APPROVE' ? 'badge approve' : 'badge reject'}>{v.verdict}</span>
  <span class="t">{modelName(v.model)}</span>
  <span class="n">{v.confidence ?? '—'}/10 · {money(v.cost_usd)}</span>
</div>))}
</div>}
</section>


</div>

<SiteFooter />
</body></html>
---
export const prerender = false;
let db_error = false;
Astro.response.headers.set('Cache-Control', 'no-store');
const { id } = Astro.params;
let kf = [];
let r = {}, sources = [], verdicts = [];
try {
  const db = Astro.locals.runtime.env.DB;
  const q = async (sql, bind) => (await db.prepare(sql).bind(...(bind||[])).all()).results;
  const rows = await q('SELECT * FROM rejected WHERE id = ?', [id]);
  r = rows[0] || {};
  sources = await q('SELECT url, fact FROM sources WHERE rejected_id = ?', [id]);
  verdicts = await q('SELECT model, verdict, confidence, generation_id, cost_usd, reasoning FROM council_verdicts WHERE rejected_id = ?', [id]);
} catch (e) {
  db_error = true;
}
try { kf = r.key_figures ? JSON.parse(r.key_figures) : []; } catch {}
const money = (n) => n==null ? '—' : '$' + Number(n).toFixed(4);
const slugTitle = (url, fallback) => {
  try {
    let slug = (url || '').split('/event/')[1] || '';
    slug = slug.replace(/-[0-9a-f]{4,}$/,'');
    if(!slug) return fallback;
    let words = slug.split('-').map(w=>{
      if(/^(by|of|in|the|a|an|on|for|and|or|to|at|its|their|from|between|after|before)$/i.test(w)) return w.toLowerCase();
      if(/^(us|uk|dc|gdp|ipo|er|wti|sep|oct|nov|hr|eu)$/i.test(w)) return w.toUpperCase();
      if(/^\d+$/.test(w)) return w;
      return w.charAt(0).toUpperCase()+w.slice(1);
    });
    let out = words.join(' ').replace(/\s*Byptptpt\s*/i,' ').replace(/\s+(by|into|in|of|for)$/,'');
    out = out.replace(/\s+/g,' ').trim();
    return out.charAt(0).toUpperCase()+out.slice(1);
  } catch { return fallback; }
};
const title = slugTitle(r.market_url, r.thesis || 'Thesis');
const modelName = (m) => (m || '').replace(/^openai\//, '').replace(/^anthropic\//, '').replace(/^moonshotai\//, '');
---
<html>
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title} — Cash Machine</title>
<style>
:root{--bg:#fbfbfa;--fg:#18181b;--mut:#8e8e93;--hair:#e8e8e6;--accent:#4f46e5;--pos:#16a34a;--neg:#dc2626}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);margin:0;padding:0;
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Inter,sans-serif;
  font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
.wrap{max-width:560px;margin:0 auto;padding:64px 20px 96px}
a{color:inherit;text-decoration:none}
a:hover{color:var(--accent)}
.id{font-size:.8rem;font-weight:600;letter-spacing:.02em;display:flex;align-items:center;gap:8px;margin-bottom:26px}
.id .dot{width:6px;height:6px;border-radius:50%;background:var(--accent)}
.id small{color:var(--mut);font-weight:400;margin-left:10px;font-size:.75rem}
nav.id a{margin-right:14px;color:var(--mut)}
nav.id a:hover{color:var(--accent)}
h1{font-size:1.05rem;font-weight:600;margin:0 0 2px;letter-spacing:-.01em;line-height:1.45}
.mut{color:var(--mut);font-size:.82rem}
section{margin-top:40px}
h2{font-size:.72rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);margin:0 0 10px}
.rows{display:flex;flex-direction:column}
.row{display:flex;justify-content:space-between;align-items:baseline;gap:14px;padding:13px 0;border-top:1px solid var(--hair);font-size:.9rem}
.rows .row:last-child{border-bottom:1px solid var(--hair)}
.row .t{min-width:0;flex:1}
.row .n{color:var(--mut);font-size:.78rem;white-space:nowrap;font-variant-numeric:tabular-nums}
.row .v{font-variant-numeric:tabular-nums;white-space:nowrap;font-weight:500}
.pos{color:var(--pos)}.neg{color:var(--neg)}
.note{font-size:.75rem;color:var(--mut);margin-top:12px}
.badge{display:inline-block;border:1px solid var(--hair);border-radius:4px;padding:1px 8px;font-size:.7rem;color:var(--mut);letter-spacing:.04em;text-transform:uppercase;margin-left:10px;vertical-align:middle}
.err{background:#fdecec;color:#b91c1c;padding:9px 12px;border-radius:6px;margin-bottom:20px;font-size:.8rem}
p.prose{margin:0;font-size:.92rem}
ul.kf{margin:10px 0 0;padding-left:18px;font-size:.9rem}
ul.kf li{margin:4px 0}
.src{padding:9px 0;border-bottom:1px solid var(--hair);font-size:.85rem}
.src:last-child{border-bottom:1px solid var(--hair)}
.src .fact{color:var(--mut);font-size:.8rem;margin-top:2px}
.verdict{display:flex;align-items:baseline;gap:12px;padding:11px 0;border-bottom:1px solid var(--hair);font-size:.88rem}
.verdict:last-child{border-bottom:1px solid var(--hair)}
.reason{border-left:2px solid var(--hair);padding:2px 0 2px 14px;color:var(--fg);font-size:.92rem;white-space:pre-wrap}
.statline{display:flex;gap:26px;padding:18px 0;border-top:1px solid var(--hair);border-bottom:1px solid var(--hair)}
.stat .v{font-size:1.05rem;font-weight:600;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.stat .k{font-size:.7rem;color:var(--mut);margin-top:2px;white-space:nowrap}
footer{margin-top:72px;display:flex;gap:20px;font-size:.75rem;color:var(--mut)}
footer a{color:var(--mut)}footer a:hover{color:var(--accent)}
@media (max-width:640px){
  .wrap{padding:40px 16px 64px}
  .statline{gap:18px;flex-wrap:wrap}
}
</style>
</head>
<body>
<div class="wrap">
{db_error && <div class="err">Ledger unreachable — figures may be incomplete.</div>}

<nav class="id"><span class="dot"></span><a href="/">Cash machine</a><a href="/council/">council</a><a href="/history/">history</a></nav>

<header>
  <h1>{title}<span class="badge">{r.decision}</span></h1>
  {r.market_url && <p class="mut"><a href={r.market_url} target="_blank" rel="noopener">View market on Polymarket →</a></p>}
</header>

<div class="statline">
  <div class="stat"><div class="v">{r.side || '—'}</div><div class="k">side</div></div>
  <div class="stat"><div class="v">{(r.my_est_yes ?? '') === '' || isNaN(Number(r.my_est_yes)) ? '—' : (Number(r.my_est_yes)*100).toFixed(0)+'%'}</div><div class="k">my estimate</div></div>
  <div class="stat"><div class="v">{r.proposed_price!=null?(Number(r.proposed_price)*100).toFixed(0)+'%':'—'}</div><div class="k">proposed</div></div>
  <div class="stat"><div class="v">{r.market_price_yes!=null?(Number(r.market_price_yes)*100).toFixed(0)+'%':'—'}</div><div class="k">market</div></div>
  <div class="stat"><div class="v">{(r.ts_utc||'—').slice(0,10)}</div><div class="k">date</div></div>
</div>

{r.reason && <section><h2>Reasoning</h2><p class="reason">{r.reason}</p></section>}
{r.lesson && <section><h2>Lesson</h2><p class="reason">{r.lesson}</p></section>}
{kf.length > 0 && <section><h2>Key figures</h2><ul class="kf">{kf.map((f,i) => <li>{typeof f === 'string' ? f : (f.fact || f.market || Object.entries(f).map(([k2,v2]) => k2+': '+String(v2)).join(' · '))}</li>)}</ul></section>}

<section>
<h2>Evidence sources</h2>
{sources.length === 0 ? <p class="mut">No sources recorded</p> :
<div class="rows">
{sources.map(s=>(<div class="src"><a href={s.url} target="_blank" rel="noopener">{s.url?.replace(/^https?:\/\//,'').slice(0,60)}</a>{s.fact && <div class="fact">{s.fact}</div>}</div>))}
</div>}
</section>

<section>
<h2>Council verdicts</h2>
{verdicts.length === 0 ? <p class="mut">No council record</p> :
<div class="rows">
{verdicts.map(v=>(<div class="verdict">
  <span class={v.verdict === 'APPROVE' ? 'badge approve' : 'badge reject'}>{v.verdict}</span>
  <span class="t">{modelName(v.model)}</span>
  <span class="n">{v.confidence ?? '—'}/10 · {money(v.cost_usd)}</span>
</div>))}
</div>}
</section>

<footer><a href="/">home</a><a href="/council/">council</a><a href="/history/">history</a></footer>
</div>
</body></html>
---
export const prerender = false;
let db_error = false;
Astro.response.headers.set('Cache-Control', 'no-store');
const { id } = Astro.params;
let kf = [];
const isHash = (s) => /0x[0-9a-f]{16,}/i.test(s || '');
let r = {}, sources = [], verdicts = [];
try {
  const db = Astro.locals.runtime.env.DB;
  const q = async (sql, bind) => (await db.prepare(sql).bind(...(bind||[])).all()).results;
  const rows = await q('SELECT * FROM rejected WHERE id = ?', [id]);
  r = rows[0] || {};
  sources = await q('SELECT url, fact FROM sources WHERE rejected_id = ?', [id]);
  verdicts = await q('SELECT model, verdict, confidence, generation_id, cost_usd, reasoning FROM council_verdicts WHERE rejected_id = ?', [id]);
} catch (e) {
  db_error = true;
}
try { kf = r.key_figures ? JSON.parse(r.key_figures) : []; } catch {}
const money = (n) => n==null ? '—' : '$' + Number(n).toFixed(4);
const slugTitle = (url, fallback) => {
  try {
    let slug = (url || '').split('/event/')[1] || '';
    slug = slug.replace(/-[0-9a-f]{4,}$/,'');
    if(!slug) return fallback;
    let words = slug.split('-').map(w=>{
      if(/^(by|of|in|the|a|an|on|for|and|or|to|at|its|their|from|between|after|before)$/i.test(w)) return w.toLowerCase();
      if(/^(us|uk|dc|gdp|ipo|er|wti|sep|oct|nov|hr|eu)$/i.test(w)) return w.toUpperCase();
      if(/^\d+$/.test(w)) return w;
      return w.charAt(0).toUpperCase()+w.slice(1);
    });
    let out = words.join(' ').replace(/\s*Byptptpt\s*/i,' ').replace(/\s+(by|into|in|of|for)$/,'');
    out = out.replace(/\s+/g,' ').trim();
    return out.charAt(0).toUpperCase()+out.slice(1);
  } catch { return fallback; }
};
const title = slugTitle(r.market_url, r.thesis || 'Thesis');
const modelName = (m) => (m || '').replace(/^openai\//, '').replace(/^anthropic\//, '').replace(/^moonshotai\//, '');
---
<html>
<head>
<meta charset="utf-8"/>
<script is:inline>
(function(){
  try {
    var pref = new URLSearchParams(location.search).get('theme') || localStorage.getItem('cm-theme') || 'auto';
    var dark = pref === 'dark' || (pref === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
  } catch(e) {}
})();
</script>
<style is:global>
:root{--pos:#0f8a3d;--neg:#d64545}
html[data-theme=dark]{
  --bg:#101013;--fg:#e6e6e9;--mut:#8b8b92;--hair:#26262b;--accent:#8b8bf5;
  --pos:#3fbf6e;--neg:#e56060;
}
html[data-theme=dark] body{background:var(--bg)}
.theme-t{background:none;border:1px solid var(--hair);border-radius:6px;color:var(--mut);
  font:inherit;font-size:.72rem;padding:3px 9px;cursor:pointer;letter-spacing:.03em}
.theme-t:hover{color:var(--fg);border-color:var(--mut)}
</style>

<meta name="viewport" content="width=device-width,initial-scale=1"/><link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600&display=swap" rel="stylesheet">
<title>{title} — Cash Machine</title>
<style>
:root{--bg:#fbfbfa;--fg:#18181b;--mut:#8e8e93;--hair:#e8e8e6;--accent:#4f46e5;--pos:#16a34a;--neg:#dc2626--serif:'Newsreader',Georgia,serif;}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);margin:0;padding:0;
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Inter,sans-serif;
  font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
.wrap{max-width:560px;margin:0 auto;padding:64px 20px 96px}
a{color:inherit;text-decoration:none}
a:hover{color:var(--accent)}
.id{font-size:.8rem;font-weight:600;letter-spacing:.02em;display:flex;align-items:center;gap:8px;margin-bottom:26px}
.id .dot{width:6px;height:6px;border-radius:50%;background:var(--accent)}
.id small{color:var(--mut);font-weight:400;margin-left:10px;font-size:.75rem}
nav.id a{margin-right:14px;color:var(--mut)}
nav.id a:hover{color:var(--accent)}
h1{font-family:var(--serif);font-size:1.35rem;font-weight:500;letter-spacing:0;margin:0 0 2px;letter-spacing:-.01em;line-height:1.45}
.mut{color:var(--mut);font-size:.82rem}
p.prose{font-family:var(--serif);font-size:1.02rem;line-height:1.6}
section{margin-top:40px}
h2{font-size:.72rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);margin:0 0 10px}
.rows{display:flex;flex-direction:column}
.row{display:flex;justify-content:space-between;align-items:baseline;gap:14px;padding:13px 0;border-top:1px solid var(--hair);font-size:.95rem}
.rows .row:last-child{border-bottom:1px solid var(--hair)}
.row .t{min-width:0;flex:1}
.row .n{color:var(--mut);font-size:.78rem;white-space:nowrap;font-variant-numeric:tabular-nums}
.row .v{font-variant-numeric:tabular-nums;white-space:nowrap;font-weight:500}
.pos{color:var(--pos)}.neg{color:var(--neg)}
.note{font-size:.75rem;color:var(--mut);margin-top:12px}
.badge{display:inline-block;border:1px solid var(--hair);border-radius:4px;padding:1px 8px;font-size:.7rem;color:var(--mut);letter-spacing:.04em;text-transform:uppercase;margin-left:10px;vertical-align:middle}
.err{background:#fdecec;color:#b91c1c;padding:9px 12px;border-radius:6px;margin-bottom:20px;font-size:.8rem}
p.prose{margin:0;font-size:.92rem}
ul.kf{margin:10px 0 0;padding-left:18px;font-size:.9rem}
ul.kf li{margin:4px 0}
.src{padding:9px 0;border-bottom:1px solid var(--hair);font-size:.85rem}
.src:last-child{border-bottom:1px solid var(--hair)}
.src .fact{color:var(--mut);font-size:.8rem;margin-top:2px}
.verdict{display:flex;align-items:baseline;gap:12px;padding:11px 0;border-bottom:1px solid var(--hair);font-size:.88rem}
.verdict:last-child{border-bottom:1px solid var(--hair)}
.reason{border-left:2px solid var(--hair);padding:2px 0 2px 14px;font-family:var(--serif);font-size:1.02rem;line-height:1.6;white-space:pre-wrap}
.statline{display:flex;gap:26px;padding:18px 0;border-top:1px solid var(--hair);border-bottom:1px solid var(--hair)}
.stat .v{font-size:1.05rem;font-weight:600;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.stat .k{font-size:.7rem;color:var(--mut);margin-top:2px;white-space:nowrap}
footer{margin-top:72px;display:flex;gap:20px;font-size:.75rem;color:var(--mut)}
footer a{color:var(--mut)}footer a:hover{color:var(--accent)}
@media (max-width:640px){
  .wrap{padding:40px 16px 64px}
  .statline{gap:18px;flex-wrap:wrap}
}
</style>
</head>
<body>
<div class="wrap">
{db_error && <div class="err">Ledger unreachable — figures may be incomplete.</div>}

<nav class="id"><span class="dot"></span><a href="/">Cash machine</a><a href="/council/">council</a><a href="/history/">history</a> <button class="theme-t" id="themeBtn" type="button" aria-label="Toggle theme">
<svg id="themeIcon" width="15" height="15" viewBox="0 0 15 15" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
<g id="icoSun" style="display:none"><circle cx="7.5" cy="7.5" r="3"/><path d="M7.5 1v1.6M7.5 12.4V14M1 7.5h1.6M12.4 7.5H14M2.9 2.9l1.1 1.1M11 11l1.1 1.1M12.1 2.9L11 4M4 11l-1.1 1.1"/></g>
<g id="icoMoon" style="display:none"><path d="M12.6 9.4A5.4 5.4 0 1 1 5.6 2.4a4.3 4.3 0 0 0 7 7z"/></g>
<g id="icoAuto" style="display:none"><circle cx="7.5" cy="7.5" r="3"/><path d="M7.5 4.5a3 3 0 0 1 0 6z" fill="currentColor" stroke="none"/></g>
</svg>
</button></nav>

<header>
  <h1>{title}</h1>
<p class="mut" style="margin:6px 0 0"><span class="badge">{r.decision}</span></p>
  {r.market_url && <p class="mut"><a href={r.market_url} target="_blank" rel="noopener">View market on Polymarket →</a></p>}
</header>

<div class="statline">
  <div class="stat"><div class="v">{r.side || '—'}</div><div class="k"><svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M2.5 10.5l4-8 4 8" stroke-linejoin="round"/></svg>side</div></div>
  <div class="stat"><div class="v">{(r.my_est_yes ?? '') === '' || isNaN(Number(r.my_est_yes)) ? '—' : (Number(r.my_est_yes)*100).toFixed(0)+'%'}</div><div class="k"><svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="6.5" cy="6.5" r="4.5"/><path d="M6.5 4v2.5l1.8 1.2" stroke-linecap="round"/></svg>my estimate</div></div>
  <div class="stat"><div class="v">{r.proposed_price!=null?(Number(r.proposed_price)*100).toFixed(0)+'%':'—'}</div><div class="k"><svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M3 10.5V6.7a3.5 3.5 0 0 1 7 0v3.8M2 11h9" stroke-linecap="round"/></svg>proposed</div></div>
  <div class="stat"><div class="v">{r.market_price_yes!=null?(Number(r.market_price_yes)*100).toFixed(0)+'%':'—'}</div><div class="k"><svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M2 5l1-2.5h7L12 5M2 5v6h10V5M2 5h10M5.5 11V8h3v3" stroke-linejoin="round"/></svg>market</div></div>
  <div class="stat"><div class="v">{(r.ts_utc||'—').slice(0,10)}</div><div class="k"><svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="2" y="3" width="9" height="8" rx="1.5"/><path d="M2 6h9M4.5 1.5v3M8.5 1.5v3" stroke-linecap="round"/></svg>date</div></div>
</div>

{r.reason && <section><h2>Reasoning</h2><p class="reason">{r.reason}</p></section>}
{r.lesson && <section><h2><svg width="12" height="12" viewBox="0 0 12 12" fill="none" style="vertical-align:-1px;margin-right:6px"><path d="M6 1.5l1.3 2.7 3 .4-2.2 2.1.5 3-2.6-1.4-2.6 1.4.5-3L1.7 4.6l3-.4L6 1.5z" stroke="currentColor" stroke-width="1.05" stroke-linejoin="round"/></svg>Lesson</h2><p class="reason">{r.lesson}</p></section>}
{kf.length > 0 && <section><h2><svg width="12" height="12" viewBox="0 0 12 12" fill="none" style="vertical-align:-1px;margin-right:6px"><path d="M2 9.5V6m3 3.5V2.5m3 7V4.5m3 5V5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>Key figures</h2><ul class="kf">{kf.map((f,i) => <li>{typeof f === 'string' ? f : (f.fact || f.market || Object.entries(f).map(([k2,v2]) => k2+': '+String(v2)).join(' · '))}</li>)}</ul></section>}

<section>
<h2><svg width="12" height="12" viewBox="0 0 12 12" fill="none" style="vertical-align:-1px;margin-right:6px"><path d="M5 2.5C3.5 1.6 2 1.8 1.5 2v7.2c1.2-.3 2.7-.1 3.5.5.8-.6 2.3-.8 3.5-.5V2c-.5-.2-2 0-3.5.9v7" stroke="currentColor" stroke-width="1.05" fill="none" stroke-linejoin="round"/></svg>Evidence sources</h2>
{sources.length === 0 ? <p class="mut">No sources recorded</p> :
<div class="rows">
{sources.filter(s=>!isHash(s.url)).map(s=>(<div class="src"><a href={s.url} target="_blank" rel="noopener">{s.url?.replace(/^https?:\/\//,'').slice(0,60)}</a>{s.fact && <div class="fact">{s.fact}</div>}</div>))}
</div>}
</section>

<section>
<h2><svg width="12" height="12" viewBox="0 0 12 12" fill="none" style="vertical-align:-1px;margin-right:6px"><circle cx="3.4" cy="6" r="2.6" stroke="currentColor" stroke-width="1.1"/><circle cx="8.6" cy="6" r="2.6" stroke="currentColor" stroke-width="1.1"/></svg>Council verdicts</h2>
{verdicts.length === 0 ? <p class="mut">No council record</p> :
<div class="rows">
{verdicts.map(v=>(<div class="verdict">
  <span class={v.verdict === 'APPROVE' ? 'badge approve' : 'badge reject'}>{v.verdict}</span>
  <span class="t">{modelName(v.model)}</span>
  <span class="n">{v.confidence ?? '—'}/10 · {money(v.cost_usd)}</span>
</div>))}
</div>}
</section>

<footer><a href="/">home</a><a href="/council/">council</a><a href="/history/">history</a></footer>
</div>
<script is:inline>
(function(){
  var b=document.getElementById('themeBtn'); if(!b) return;
  var modes=['auto','light','dark'];
  var cur=localStorage.getItem('cm-theme')||'auto';
  function apply(p){
    var dark=p==='dark'||(p==='auto'&&matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.setAttribute('data-theme',dark?'dark':'light');
    var sun=document.getElementById('icoSun'),moon=document.getElementById('icoMoon'),auto=document.getElementById('icoAuto');
    if(sun){sun.style.display=p==='light'?'':'none';moon.style.display=p==='dark'?'':'none';auto.style.display=p==='auto'?'':'none';}
  }
  apply(cur);
  b.addEventListener('click',function(){
    cur=modes[(modes.indexOf(cur)+1)%3];
    localStorage.setItem('cm-theme',cur);
    apply(cur);
  });
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change',function(){ if((localStorage.getItem('cm-theme')||'auto')==='auto') apply('auto'); });
})();
</script>
</body></html>
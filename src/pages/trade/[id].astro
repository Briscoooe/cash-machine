---
export const prerender = false;
let db_error = false;
Astro.response.headers.set('Cache-Control', 'no-store');
const { id } = Astro.params;
let t = {};
let sources = [], verdicts = [];
const isHash = (s) => /0x[0-9a-f]{16,}/i.test(s || '');
try {
  const db = Astro.locals.runtime.env.DB;
  const q = async (sql, bind) => (await db.prepare(sql).bind(...(bind||[])).all()).results;
  t = (await q('SELECT * FROM trades WHERE id = ?', [id]))[0] || {};
  sources = await q('SELECT url, fact FROM sources WHERE rejected_id = ?', [id]);
  verdicts = await q('SELECT model, verdict, confidence, cost_usd FROM council_verdicts WHERE rejected_id = ?', [id]);
} catch (e) {
  db_error = true;
}
const money = (n) => n==null ? '—' : '$' + Number(n).toFixed(2);
const pct = (n) => n==null ? '—' : (Number(n)*100).toFixed(1) + '%';
const pl = (t.realized_pl !== null && t.realized_pl !== undefined && t.realized_pl !== '') ? Number(t.realized_pl).toFixed(2) : null;
const size = t.size_usd ? Number(t.size_usd).toFixed(2) : '—';
const entry = t.entry_price ? Number(t.entry_price).toFixed(3) : '—';
const exit = t.exit_price ? Number(t.exit_price).toFixed(3) : null;
let kf = [];
try { kf = t.key_figures ? JSON.parse(t.key_figures) : []; } catch (e) {}
const estNo = (t.side||'').toUpperCase()==='NO' && t.my_est_yes != null && Number(t.my_est_yes) <= 0.5;
const estVal = t.my_est_yes == null ? null : (estNo ? 1-Number(t.my_est_yes) : Number(t.my_est_yes));
const estSide = estNo ? 'NO' : 'YES';
const modelName = (m) => (m || '').replace(/^openai\//, '').replace(/^anthropic\//, '').replace(/^moonshotai\//, '');
---
<html>
<head>
<meta charset="utf-8"/>
<script is:inline>
(function(){
  try {
    var pref = new URLSearchParams(location.search).get('theme') || localStorage.getItem('cm-theme') || 'auto';
    var dark = pref === 'dark' || (pref === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
  } catch(e) {}
})();
</script>
<style is:global>
:root{--pos:#0f8a3d;--neg:#d64545}
html[data-theme=dark]{
  --bg:#101013;--fg:#e6e6e9;--mut:#8b8b92;--hair:#26262b;--accent:#8b8bf5;
  --pos:#3fbf6e;--neg:#e56060;
}
html[data-theme=dark] body{background:var(--bg)}
.theme-t{background:none;border:1px solid var(--hair);border-radius:6px;color:var(--mut);
  font:inherit;font-size:.72rem;padding:3px 9px;cursor:pointer;letter-spacing:.03em}
.theme-t:hover{color:var(--fg);border-color:var(--mut)}
</style>

<meta name="viewport" content="width=device-width,initial-scale=1"/><link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600&display=swap" rel="stylesheet">
<title>{t.id || 'trade'} — Cash Machine</title>
<style>
:root{--bg:#fbfbfa;--fg:#18181b;--mut:#8e8e93;--hair:#e8e8e6;--accent:#4f46e5;--pos:#16a34a;--neg:#dc2626--serif:'Newsreader',Georgia,serif;}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);margin:0;padding:0;
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Inter,sans-serif;
  font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
.wrap{max-width:560px;margin:0 auto;padding:64px 20px 96px}
a{color:inherit;text-decoration:none}
a:hover{color:var(--accent)}
.id{font-size:.8rem;font-weight:600;letter-spacing:.02em;display:flex;align-items:center;gap:8px;margin-bottom:26px}
.id .dot{width:6px;height:6px;border-radius:50%;background:var(--accent)}
.id small{color:var(--mut);font-weight:400;margin-left:10px;font-size:.75rem}
nav.id a{margin-right:14px;color:var(--mut)}
nav.id a:hover{color:var(--accent)}
h1{font-family:var(--serif);font-size:1.35rem;font-weight:500;letter-spacing:0;margin:0 0 2px;letter-spacing:-.01em}
h1 code{font-size:.9rem;color:var(--mut);font-weight:500}
.mut{color:var(--mut);font-size:.82rem}
p.prose{font-family:var(--serif);font-size:1.02rem;line-height:1.6}
section{margin-top:40px}
.statline{display:flex;flex-wrap:wrap;gap:26px;margin-top:22px}
.stat .v{font-family:var(--serif);font-size:1.35rem;font-weight:500;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.stat .k{font-size:.7rem;letter-spacing:.06em;text-transform:uppercase;color:var(--mut);margin-top:1px}
h2{font-size:.72rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);margin:0 0 10px}
.rows{display:flex;flex-direction:column}
.row{display:flex;justify-content:space-between;align-items:baseline;gap:14px;padding:13px 0;border-top:1px solid var(--hair);font-size:.95rem}
.rows .row:last-child{border-bottom:1px solid var(--hair)}
.row .t{min-width:0;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:var(--serif);font-size:.98rem}
.row .n{color:var(--mut);font-size:.78rem;white-space:nowrap;font-variant-numeric:tabular-nums}
.row .v{font-variant-numeric:tabular-nums;white-space:nowrap;font-weight:500}
.pos{color:var(--pos)}.neg{color:var(--neg)}
.note{font-size:.75rem;color:var(--mut);margin-top:12px}
.badge{display:inline-block;border:1px solid var(--hair);border-radius:4px;padding:1px 8px;font-size:.7rem;letter-spacing:.04em;text-transform:uppercase}
.badge.approve{color:var(--pos);border-color:#d3ecd9}
.badge.reject{color:var(--neg);border-color:#f5d4d4}
.err{background:#fdecec;color:#b91c1c;padding:9px 12px;border-radius:6px;margin-bottom:20px;font-size:.8rem}
p.prose{margin:0;font-size:.92rem}
ul.kf{margin:10px 0 0;padding-left:18px;font-size:.9rem}
ul.kf li{margin:4px 0}
.src{padding:9px 0;border-bottom:1px solid var(--hair);font-size:.85rem}
.src:last-child{border-bottom:1px solid var(--hair)}
.src .fact{color:var(--mut);font-size:.8rem;margin-top:2px}
.verdict{display:flex;align-items:baseline;gap:12px;padding:11px 0;border-bottom:1px solid var(--hair);font-size:.88rem}
.verdict:last-child{border-bottom:1px solid var(--hair)}
.reason{border-left:2px solid var(--hair);padding:2px 0 2px 14px;font-family:var(--serif);font-size:1.02rem;white-space:pre-wrap}
footer{margin-top:72px;display:flex;gap:20px;font-size:.75rem;color:var(--mut)}
footer a{color:var(--mut)}footer a:hover{color:var(--accent)}
@media (max-width:640px){
  .wrap{padding:40px 16px 64px}
}
</style>
</head>
<body>
<div class="wrap">
{db_error && <div class="err">Ledger unreachable — figures may be incomplete.</div>}

<nav class="id"><span class="dot"></span><a href="/">Cash machine</a><a href="/council/">council</a><a href="/history/">history</a> <button class="theme-t" id="themeBtn" type="button" aria-label="Toggle theme">
<svg id="themeIcon" width="15" height="15" viewBox="0 0 15 15" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
<g id="icoSun" style="display:none"><circle cx="7.5" cy="7.5" r="3"/><path d="M7.5 1v1.6M7.5 12.4V14M1 7.5h1.6M12.4 7.5H14M2.9 2.9l1.1 1.1M11 11l1.1 1.1M12.1 2.9L11 4M4 11l-1.1 1.1"/></g>
<g id="icoMoon" style="display:none"><path d="M12.6 9.4A5.4 5.4 0 1 1 5.6 2.4a4.3 4.3 0 0 0 7 7z"/></g>
<g id="icoAuto" style="display:none"><circle cx="7.5" cy="7.5" r="3"/><path d="M7.5 4.5a3 3 0 0 1 0 6z" fill="currentColor" stroke="none"/></g>
</svg>
</button></nav>

<header>
  <h1>{t.market || t.id || 'Trade not found'}</h1>
  {t.market && <p class="mut">{t.id} · {t.side} · <span class="badge">{t.status || 'open'}</span></p>}
</header>

<div class="statline">
  <div class="stat"><div class="v">{money(t.size_usd)}</div><div class="k"><svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="6.5" cy="6.5" r="4.5"/><path d="M6.5 4v5M4.8 5.2 6.5 4l1.7 1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>size</div></div>
  <div class="stat"><div class="v">{t.entry_price ? pct(t.entry_price) : '—'}</div><div class="k"><svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M2 11L11 2M11 2H6.5M11 2v4.5" stroke-linecap="round" stroke-linejoin="round"/></svg>entry</div></div>
  {exit && <div class="stat"><div class="v">{pct(exit)}</div><div class="k"><svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M11 2L2 11M2 11h4.5M2 11V6.5" stroke-linecap="round" stroke-linejoin="round"/></svg>exit</div></div>}
  <div class="stat"><div class="v">{estVal != null ? pct(estVal) : '—'}</div><div class="k"><svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="6.5" cy="6.5" r="4.5"/><path d="M6.5 4v2.5l1.8 1.2" stroke-linecap="round"/></svg>my est. {estSide}</div></div>
  {pl && <div class="stat"><div class="v num {Number(pl)>=0?'pos':'neg'}">{Number(pl)>=0?'+':''}{money(pl)}</div><div class="k">realized p/l</div></div>}
  <div class="stat"><div class="v">{(t.ts_utc||'—').slice(0,10)}</div><div class="k"><svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="2" y="3" width="9" height="8" rx="1.5"/><path d="M2 6h9M4.5 1.5v3M8.5 1.5v3" stroke-linecap="round"/></svg>opened</div></div>
</div>

{t.thesis && <section><h2><svg width="12" height="12" viewBox="0 0 12 12" fill="none" style="vertical-align:-1px;margin-right:6px"><circle cx="6" cy="6" r="4.6" stroke="currentColor" stroke-width="1.1"/><path d="M6 4.4v3.2M6 8.6h.01" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/></svg>Thesis</h2><p class="reason">{t.thesis}</p></section>}

{kf.length > 0 && <section><h2><svg width="12" height="12" viewBox="0 0 12 12" fill="none" style="vertical-align:-1px;margin-right:6px"><path d="M2 9.5V6m3 3.5V2.5m3 7V4.5m3 5V5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>Key figures</h2>
<ul class="kf">
{kf.map(k => {
  const FMT = {entry:['Entry', v => (Number(v)*100).toFixed(1)+'%'], size_usd:['Size', v => '$'+Number(v).toFixed(2)],
    shares:['Shares', v => String(v)], expected_profit:['Expected profit', v => '+$'+Number(String(v).replace('~',''))],
    settlement:['Settles', v => String(v)], market:['Market', v => String(v)]};
  const label0 = k.market || k.fact || '';
  const rest = { ...k };
  delete rest.market; delete rest.fact;
  const parts = Object.entries(rest).map(([key, val]) => {
    const f = FMT[key];
    return f ? f[0] + ' ' + f[1](val) : key.replace(/_/g,' ') + ' ' + String(val);
  });
  return <li>{label0 ? <b>{label0} — </b> : null}{parts.join(' · ')}</li>;
})}
</ul>
</section>}

{verdicts.length > 0 && <section><h2><svg width="12" height="12" viewBox="0 0 12 12" fill="none" style="vertical-align:-1px;margin-right:6px"><circle cx="3.4" cy="6" r="2.6" stroke="currentColor" stroke-width="1.1"/><circle cx="8.6" cy="6" r="2.6" stroke="currentColor" stroke-width="1.1"/></svg>Council verdicts</h2>
<div class="rows">
{verdicts.map(v => (
<div class="verdict">
  <span class={v.verdict === 'APPROVE' ? 'badge approve' : 'badge reject'}>{v.verdict}</span>
  <span class="t">{(v.model || '').replace(/^openai\//,'').replace(/^anthropic\//,'').replace(/^moonshotai\//,'')}</span>
  {v.confidence && <span class="n">confidence {v.confidence}/10</span>}
  {v.cost_usd && <span class="n">${Number(v.cost_usd).toFixed(3)}</span>}
</div>
))}
</div>
</section>}

{sources.length > 0 && <section><h2><svg width="12" height="12" viewBox="0 0 12 12" fill="none" style="vertical-align:-1px;margin-right:6px"><path d="M5 2.5C3.5 1.6 2 1.8 1.5 2v7.2c1.2-.3 2.7-.1 3.5.5.8-.6 2.3-.8 3.5-.5V2c-.5-.2-2 0-3.5.9v7" stroke="currentColor" stroke-width="1.05" fill="none" stroke-linejoin="round"/></svg>Evidence sources</h2>
<div class="rows">
{sources.filter(s => !isHash(s.url)).map(s => (
<div class="src">
  <a href={s.url} target="_blank" rel="noopener">{s.url.replace(/^https?:\/\/(www\.)?/, '').slice(0, 60)}</a>
  {s.fact && <div class="fact">{s.fact}</div>}
</div>
))}
</div>
</section>}

{t.lesson && <section><h2><svg width="12" height="12" viewBox="0 0 12 12" fill="none" style="vertical-align:-1px;margin-right:6px"><path d="M6 1.5l1.3 2.7 3 .4-2.2 2.1.5 3-2.6-1.4-2.6 1.4.5-3L1.7 4.6l3-.4L6 1.5z" stroke="currentColor" stroke-width="1.05" stroke-linejoin="round"/></svg>Lesson</h2><p class="reason">{t.lesson}</p></section>}

{t.market_url && <p class="note"><a href={t.market_url} target="_blank" rel="noopener">View market on Polymarket →</a></p>}


<footer><a href="/">home</a><a href="/council/">council</a><a href="/history/">history</a></footer>
</div>
<script is:inline>
(function(){
  var b=document.getElementById('themeBtn'); if(!b) return;
  var modes=['auto','light','dark'];
  var cur=localStorage.getItem('cm-theme')||'auto';
  function apply(p){
    var dark=p==='dark'||(p==='auto'&&matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.setAttribute('data-theme',dark?'dark':'light');
    var sun=document.getElementById('icoSun'),moon=document.getElementById('icoMoon'),auto=document.getElementById('icoAuto');
    if(sun){sun.style.display=p==='light'?'':'none';moon.style.display=p==='dark'?'':'none';auto.style.display=p==='auto'?'':'none';}
  }
  apply(cur);
  b.addEventListener('click',function(){
    cur=modes[(modes.indexOf(cur)+1)%3];
    localStorage.setItem('cm-theme',cur);
    apply(cur);
  });
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change',function(){ if((localStorage.getItem('cm-theme')||'auto')==='auto') apply('auto'); });
})();
</script>
</body>
</html>
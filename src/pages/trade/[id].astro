---
export const prerender = false;
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import '../../styles/global.css';
import { fmtDate, fmtAgo } from '../../lib/dates.js';
import Icon from '../../components/Icon.astro';
let db_error = false;
Astro.response.headers.set('Cache-Control', 'no-store');
const { id } = Astro.params;
let t = {};
let sources = [], verdicts = [];
const isHash = (s) => /0x[0-9a-f]{16,}/i.test(s || '');
try {
  const db = Astro.locals.runtime.env.DB;
  const q = async (sql, bind) => (await db.prepare(sql).bind(...(bind||[])).all()).results;
  t = (await q('SELECT * FROM trades WHERE id = ?', [id]))[0] || {};
  sources = await q('SELECT url, fact FROM sources WHERE rejected_id = ?', [id]);
  verdicts = await q('SELECT model, verdict, round, confidence, cost_usd FROM council_verdicts WHERE rejected_id = ?', [id]);
} catch (e) {
  db_error = true;
}
const money = (n) => n==null ? '—' : '$' + Number(n).toFixed(2);
const pct = (n) => n==null ? '—' : (Number(n)*100).toFixed(1) + '%';
const pl = (t.realized_pl !== null && t.realized_pl !== undefined && t.realized_pl !== '') ? Number(t.realized_pl).toFixed(2) : null;
const size = t.size_usd ? Number(t.size_usd).toFixed(2) : '—';
const entry = t.entry_price ? Number(t.entry_price).toFixed(3) : '—';
const exit = t.exit_price ? Number(t.exit_price).toFixed(3) : null;
let kf = [];
try { kf = t.key_figures ? JSON.parse(t.key_figures) : []; } catch (e) {}
const estNo = (t.side||'').toUpperCase()==='NO' && t.my_est_yes != null && Number(t.my_est_yes) <= 0.5;
const estVal = t.my_est_yes == null ? null : (estNo ? 1-Number(t.my_est_yes) : Number(t.my_est_yes));
const estSide = estNo ? 'NO' : 'YES';
const modelName = (m) => (m || '').replace(/^openai\//, '').replace(/^anthropic\//, '').replace(/^moonshotai\//, '');
---
<html>
<head>
<meta charset="utf-8"/>
<script is:inline>
(function(){
  try {
    var pref = new URLSearchParams(location.search).get('theme') || localStorage.getItem('cm-theme') || 'auto';
    var dark = pref === 'dark' || (pref === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
  } catch(e) {}
})();
</script>
<style is:global>
:root{--pos:#0f8a3d;--neg:#d64545}
html[data-theme=dark]{
  --bg:#101013;--fg:#e6e6e9;--mut:#8b8b92;--hair:#26262b;--accent:#8b8bf5;
  --pos:#3fbf6e;--neg:#e56060;
}
html[data-theme=dark] body{background:var(--bg)}
.theme-t{background:none;border:1px solid var(--hair);border-radius:6px;color:var(--mut);
  font:inherit;font-size:.72rem;padding:3px 9px;cursor:pointer;letter-spacing:.03em}
.theme-t:hover{color:var(--fg);border-color:var(--mut)}
</style>

<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{t.id || 'trade'} — Cash Machine</title>
<style is:global>.badge{display:inline-block;border:1px solid var(--hair);border-radius:4px;padding:1px 8px;font-size:.7rem;letter-spacing:.04em;text-transform:uppercase}
.badge.approve{color:var(--pos);border-color:#d3ecd9}
.badge.reject{color:var(--neg);border-color:#f5d4d4}
ul.kf{margin:10px 0 0;padding-left:18px;font-size:.9rem}
ul.kf li{margin:4px 0}
.src{padding:9px 0;border-bottom:1px solid var(--hair);font-size:.85rem}
.src:last-child{border-bottom:1px solid var(--hair)}
.src .fact{color:var(--mut);font-size:.8rem;margin-top:2px}
.verdict{display:flex;align-items:baseline;gap:12px;padding:11px 0;border-bottom:1px solid var(--hair);font-size:.88rem}
.verdict:last-child{border-bottom:1px solid var(--hair)}
.reason{border-left:2px solid var(--hair);padding:2px 0 2px 14px;font-family:var(--serif);font-size:1.02rem;white-space:pre-wrap}
.k{gap:4px}</style>
</head>
<body>
<div class="wrap">
{db_error && <div class="err">Ledger unreachable — figures may be incomplete.</div>}

<SiteNav />

<header>
  <h1>{t.market || t.id || 'Trade not found'}</h1>
  {t.market && <p class="mut">{t.id} · {t.side} · <span class="badge">{t.status || 'open'}</span></p>}
</header>

<div class="statline">
  <div class="stat"><div class="v">{money(t.size_usd)}</div><div class="k"><Icon name="coins" size={11} /> size</div></div>
  <div class="stat"><div class="v">{t.entry_price ? pct(t.entry_price) : '—'}</div><div class="k"><Icon name="log-in" size={11} /> entry</div></div>
  {exit && <div class="stat"><div class="v">{pct(exit)}</div><div class="k"><Icon name="log-out" size={11} /> exit</div></div>}
  <div class="stat"><div class="v">{estVal != null ? pct(estVal) : '—'}</div><div class="k">our est. {estSide}</div></div>
  {pl && <div class="stat"><div class="v num {Number(pl)>=0?'pos':'neg'}">{Number(pl)>=0?'+':''}{money(pl)}</div><div class="k"><Icon name="trending-up" size={11} /> p/l</div></div>}
  <div class="stat"><div class="v">{fmtAgo(t.ts_utc)}</div><div class="k"><Icon name="calendar" size={11} /> opened</div></div>
</div>

{t.thesis && <section><h2><Icon name="file-text" size=12 cls="h2ic" />Thesis</h2><p class="reason">{t.thesis}</p></section>}

{kf.length > 0 && <section><h2><Icon name="sigma" size=12 cls="h2ic" />Key figures</h2>
<ul class="kf">
{kf.map(k => {
  const FMT = {entry:['Entry', v => (Number(v)*100).toFixed(1)+'%'], size_usd:['Size', v => '$'+Number(v).toFixed(2)],
    shares:['Shares', v => String(v)], expected_profit:['Expected profit', v => '+$'+Number(String(v).replace('~',''))],
    settlement:['Settles', v => { const d = new Date(String(v)); return isNaN(d) ? String(v) : fmtDate(d); }], market:['Market', v => String(v)]};
    FMT.note = ['', v => String(v)];
  const label0 = k.market || k.fact || '';
  const rest = { ...k };
  delete rest.market; delete rest.fact;
  const parts = Object.entries(rest).map(([key, val]) => {
    const f = FMT[key];
    return f ? f[0] + ' ' + f[1](val) : key.replace(/_/g,' ') + ' ' + String(val);
  });
  return <li>{label0 ? <b>{label0} — </b> : null}{parts.join(' · ')}</li>;
})}
</ul>
</section>}

{verdicts.length > 0 && <section><h2><Icon name="users" size=12 cls="h2ic" />Council verdicts</h2>
<div class="rows">
{verdicts.map(v => (
<div class="verdict">
  <span class={v.verdict === 'APPROVE' ? 'badge approve' : 'badge reject'}>{v.verdict}</span>
  <span class="t">{(v.model || '').replace(/^openai\//,'').replace(/^anthropic\//,'').replace(/^moonshotai\//,'')}</span>
  {v.round && <span class="n">{v.round}</span>}
  {v.confidence && <span class="n">confidence {v.confidence}/10</span>}
  {v.cost_usd && <span class="n">${Number(v.cost_usd).toFixed(3)}</span>}
</div>
))}
</div>
</section>}

{sources.length > 0 && <section><h2><Icon name="book-open" size=12 cls="h2ic" />Evidence sources</h2>
<div class="rows">
{sources.filter(s => !isHash(s.url)).map(s => (
<div class="src">
  <a href={s.url} target="_blank" rel="noopener">{s.url.replace(/^https?:\/\/(www\.)?/, '').slice(0, 60)}</a>
  {s.fact && <div class="fact">{s.fact}</div>}
</div>
))}
</div>
</section>}

{t.lesson && <section><h2><Icon name="graduation-cap" size=12 cls="h2ic" />Lesson</h2><p class="reason">{t.lesson}</p></section>}

{t.market_url && <p class="note"><a href={t.market_url} target="_blank" rel="noopener">View market on Polymarket →</a></p>}



</div>

<SiteFooter />
</body>
</html>
---
export const prerender = false;
let db_error = false;
Astro.response.headers.set('Cache-Control', 'no-store');
const { id } = Astro.params;
let t = {};
let sources = [], verdicts = [];
try {
  const db = Astro.locals.runtime.env.DB;
  const q = async (sql, bind) => (await db.prepare(sql).bind(...(bind||[])).all()).results;
  t = (await q('SELECT * FROM trades WHERE id = ?', [id]))[0] || {};
  sources = await q('SELECT url, fact FROM sources WHERE rejected_id = ?', [id]);
  verdicts = await q('SELECT model, verdict, confidence, cost_usd FROM council_verdicts WHERE rejected_id = ?', [id]);
} catch (e) {
  db_error = true;
}
const money = (n) => n==null ? '—' : '$' + Number(n).toFixed(2);
const pct = (n) => n==null ? '—' : (Number(n)*100).toFixed(1) + '%';
const pl = (t.realized_pl !== null && t.realized_pl !== undefined && t.realized_pl !== '') ? Number(t.realized_pl).toFixed(2) : null;
const size = t.size_usd ? Number(t.size_usd).toFixed(2) : '—';
const entry = t.entry_price ? Number(t.entry_price).toFixed(3) : '—';
const exit = t.exit_price ? Number(t.exit_price).toFixed(3) : null;
let kf = [];
try { kf = t.key_figures ? JSON.parse(t.key_figures) : []; } catch (e) {}
const modelName = (m) => (m || '').replace(/^openai\//, '').replace(/^anthropic\//, '').replace(/^moonshotai\//, '');
---
<html>
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{t.id || 'trade'} — Cash Machine</title>
<style>
:root{--bg:#fbfbfa;--fg:#18181b;--mut:#8e8e93;--hair:#e8e8e6;--accent:#4f46e5;--pos:#16a34a;--neg:#dc2626}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);margin:0;padding:0;
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Inter,sans-serif;
  font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
.wrap{max-width:560px;margin:0 auto;padding:64px 20px 96px}
a{color:inherit;text-decoration:none}
a:hover{color:var(--accent)}
.id{font-size:.8rem;font-weight:600;letter-spacing:.02em;display:flex;align-items:center;gap:8px;margin-bottom:26px}
.id .dot{width:6px;height:6px;border-radius:50%;background:var(--accent)}
.id small{color:var(--mut);font-weight:400;margin-left:10px;font-size:.75rem}
nav.id a{margin-right:14px;color:var(--mut)}
nav.id a:hover{color:var(--accent)}
h1{font-size:1.05rem;font-weight:600;margin:0 0 2px;letter-spacing:-.01em}
h1 code{font-size:.9rem;color:var(--mut);font-weight:500}
.mut{color:var(--mut);font-size:.82rem}
section{margin-top:40px}
h2{font-size:.72rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);margin:0 0 10px}
.rows{display:flex;flex-direction:column}
.row{display:flex;justify-content:space-between;align-items:baseline;gap:14px;padding:13px 0;border-top:1px solid var(--hair);font-size:.9rem}
.rows .row:last-child{border-bottom:1px solid var(--hair)}
.row .t{min-width:0;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.row .n{color:var(--mut);font-size:.78rem;white-space:nowrap;font-variant-numeric:tabular-nums}
.row .v{font-variant-numeric:tabular-nums;white-space:nowrap;font-weight:500}
.pos{color:var(--pos)}.neg{color:var(--neg)}
.note{font-size:.75rem;color:var(--mut);margin-top:12px}
.badge{display:inline-block;border:1px solid var(--hair);border-radius:4px;padding:1px 8px;font-size:.7rem;letter-spacing:.04em;text-transform:uppercase}
.badge.approve{color:var(--pos);border-color:#d3ecd9}
.badge.reject{color:var(--neg);border-color:#f5d4d4}
.err{background:#fdecec;color:#b91c1c;padding:9px 12px;border-radius:6px;margin-bottom:20px;font-size:.8rem}
p.prose{margin:0;font-size:.92rem}
ul.kf{margin:10px 0 0;padding-left:18px;font-size:.9rem}
ul.kf li{margin:4px 0}
.src{padding:9px 0;border-bottom:1px solid var(--hair);font-size:.85rem}
.src:last-child{border-bottom:1px solid var(--hair)}
.src .fact{color:var(--mut);font-size:.8rem;margin-top:2px}
.verdict{display:flex;align-items:baseline;gap:12px;padding:11px 0;border-bottom:1px solid var(--hair);font-size:.88rem}
.verdict:last-child{border-bottom:1px solid var(--hair)}
.reason{border-left:2px solid var(--hair);padding:2px 0 2px 14px;font-size:.92rem;white-space:pre-wrap}
footer{margin-top:72px;display:flex;gap:20px;font-size:.75rem;color:var(--mut)}
footer a{color:var(--mut)}footer a:hover{color:var(--accent)}
@media (max-width:640px){
  .wrap{padding:40px 16px 64px}
}
</style>
</head>
<body>
<div class="wrap">
{db_error && <div class="err">Ledger unreachable — figures may be incomplete.</div>}

<nav class="id"><span class="dot"></span><a href="/">Cash machine</a><a href="/council/">council</a><a href="/history/">history</a></nav>

<header>
  <h1>{t.market || t.id || 'Trade not found'}</h1>
  {t.market && <p class="mut">{t.id} · {t.side} · <span class="badge">{t.status || 'open'}</span></p>}
</header>

<div class="statline">
  <div class="stat"><div class="v">{money(t.size_usd)}</div><div class="k">size</div></div>
  <div class="stat"><div class="v">{t.entry_price ? pct(t.entry_price) : '—'}</div><div class="k">entry</div></div>
  {exit && <div class="stat"><div class="v">{pct(exit)}</div><div class="k">exit</div></div>}
  <div class="stat"><div class="v">{t.my_est_yes != null ? pct(t.my_est_yes) : '—'}</div><div class="k">my estimate</div></div>
  {pl && <div class="stat"><div class="v num {Number(pl)>=0?'pos':'neg'}">{Number(pl)>=0?'+':''}{money(pl)}</div><div class="k">realized p/l</div></div>}
  <div class="stat"><div class="v">{(t.ts_utc||'—').slice(0,10)}</div><div class="k">opened</div></div>
</div>

{t.thesis && <section><h2>Thesis</h2><p class="reason">{t.thesis}</p></section>}

{kf.length > 0 && <section><h2>Key figures</h2>
<ul class="kf">
{kf.map(k => {
  const label = k.market || k.fact || Object.keys(k)[0];
  const rest = { ...k };
  delete rest.market; delete rest.fact;
  return <li>{k.fact || <>{k.market ? <b>{k.market}</b> : null} {Object.entries(rest).map(([key, val]) => <span>{key}: {String(val)}{val === rest[Object.keys(rest)[Object.keys(rest).length-1]] ? '' : ' · '}</span>)}</>}</li>;
})}
</ul>
</section>}

{verdicts.length > 0 && <section><h2>Council verdicts</h2>
<div class="rows">
{verdicts.map(v => (
<div class="verdict">
  <span class={v.verdict === 'APPROVE' ? 'badge approve' : 'badge reject'}>{v.verdict}</span>
  <span class="t">{(v.model || '').replace(/^openai\//,'').replace(/^anthropic\//,'').replace(/^moonshotai\//,'')}</span>
  {v.confidence && <span class="n">confidence {v.confidence}/10</span>}
  {v.cost_usd && <span class="n">${Number(v.cost_usd).toFixed(3)}</span>}
</div>
))}
</div>
</section>}

{sources.length > 0 && <section><h2>Evidence sources</h2>
<div class="rows">
{sources.map(s => (
<div class="src">
  <a href={s.url} target="_blank" rel="noopener">{s.url.replace(/^https?:\/\/(www\.)?/, '').slice(0, 60)}</a>
  {s.fact && <div class="fact">{s.fact}</div>}
</div>
))}
</div>
</section>}

{t.lesson && <section><h2>Lesson</h2><p class="reason">{t.lesson}</p></section>}

{t.market_url && <p class="note"><a href={t.market_url} target="_blank" rel="noopener">View market on Polymarket →</a></p>}
{t.condition_id && <p class="note"><code>{t.condition_id.slice(0,26)}…</code></p>}

<footer><a href="/">home</a><a href="/council/">council</a><a href="/history/">history</a></footer>
</div>
</body>
</html>
---
export const prerender = false;
import { fmtDate, fmtAgo } from '../lib/dates.js';
import Icon from '../components/Icon.astro';
let db_error = false;
Astro.response.headers.set('Cache-Control', 'no-store');
let runs_recent = [], costs_daily = [], verdicts = [];
try {
  const db = Astro.locals.runtime.env.DB;
  const q = async (sql) => (await db.prepare(sql).all()).results;
  runs_recent = await q('SELECT ts_utc, model, trigger, generation_id, cost_usd FROM council_runs ORDER BY ts_utc DESC LIMIT 50');
  costs_daily = await q('SELECT * FROM daily_totals ORDER BY date_utc DESC');
  verdicts = await q('SELECT v.rejected_id id, v.model, v.verdict, v.confidence FROM council_verdicts v ORDER BY v.id DESC LIMIT 120');
  const titles = await q('SELECT id, market_url FROM rejected');
  const slugTitle = (url) => { try { const slug = new URL(url).pathname.split('/').pop() || url; return slug.split('-').slice(0,-1).map(w=>w[0].toUpperCase()+w.slice(1)).join(' ') || slug; } catch { return url; } };
  const titleById = Object.fromEntries(titles.map(t=>[t.id, t.market_url ? slugTitle(t.market_url) : t.id]));
  const modelShort = (m) => ({'openai/gpt-6-astra':'gpt-6-astra','anthropic/claude-fable-5.1':'fable-5.1','moonshotai/kimi-k3':'kimi-k3'}[m] || m.split('/').pop());
  const groups = {};
  for (const v of verdicts) { (groups[v.id] = groups[v.id] || []).push(v); }
  var verdictGroups = Object.entries(groups).map(([id, vs]) => ({ id, title: titleById[id] || id, vs: vs.map(v=>({m: modelShort(v.model), verdict: v.verdict})) }));
  verdictGroups = verdictGroups.slice(0, 20);
} catch (e) {
  db_error = true;
}
const money = (n) => n==null ? '—' : '$' + Number(n).toFixed(4);
const tot = costs_daily.reduce((a,d)=>a+d.total_cost_usd, 0);
const modelName = (m) => (m || '').replace(/^openai\//, '').replace(/^anthropic\//, '').replace(/^moonshotai\//, '');
---
<html>
<head>
<meta charset="utf-8"/>
<script is:inline>
(function(){
  try {
    var pref = new URLSearchParams(location.search).get('theme') || localStorage.getItem('cm-theme') || 'auto';
    var dark = pref === 'dark' || (pref === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
  } catch(e) {}
})();
</script>
<style is:global>
:root{--pos:#0f8a3d;--neg:#d64545}
html[data-theme=dark]{
  --bg:#101013;--fg:#e6e6e9;--mut:#8b8b92;--hair:#26262b;--accent:#8b8bf5;
  --pos:#3fbf6e;--neg:#e56060;
}
html[data-theme=dark] body{background:var(--bg)}
.theme-t{background:none;border:1px solid var(--hair);border-radius:6px;color:var(--mut);
  font:inherit;font-size:.72rem;padding:3px 9px;cursor:pointer;letter-spacing:.03em}
.theme-t:hover{color:var(--fg);border-color:var(--mut)}
</style>

<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Council — Cash Machine</title>
<style>
@font-face{font-family:Newsreader;font-style:normal;font-weight:400 600;font-display:swap;src:url(/fonts/newsreader-normal.woff2) format('woff2')}
@font-face{font-family:Newsreader;font-style:italic;font-weight:400;font-display:swap;src:url(/fonts/newsreader-italic.woff2) format('woff2')}
:root{--bg:#fbfbfa;--fg:#18181b;--mut:#8e8e93;--hair:#e8e8e6;--accent:#4f46e5;--pos:#16a34a;--neg:#dc2626;--serif:'Newsreader',Georgia,serif;}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);margin:0;padding:0;
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Inter,sans-serif;
  font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
.wrap{max-width:640px;margin:0 auto;padding:64px 20px 96px}
a{color:inherit;text-decoration:none}
a:hover{color:var(--accent)}
.id{font-size:.8rem;font-weight:600;letter-spacing:.02em;display:flex;align-items:center;gap:8px;margin-bottom:26px}
.id .dot{width:6px;height:6px;border-radius:50%;background:var(--accent)}
.id small{color:var(--mut);font-weight:400;margin-left:10px;font-size:.75rem}
nav.id a{margin-right:14px;color:var(--mut)}
nav.id a:hover{color:var(--accent)}
h1{font-family:var(--serif);font-size:1.35rem;font-weight:500;letter-spacing:0;margin:0 0 2px;letter-spacing:-.01em}
.mut{color:var(--mut);font-size:.82rem}
p.prose{font-family:var(--serif);font-size:1.02rem;line-height:1.6}
section{margin-top:40px}
h2{font-size:.72rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);margin:0 0 10px}
.rows{display:flex;flex-direction:column}
.row{display:flex;justify-content:space-between;align-items:baseline;gap:14px;padding:13px 0;border-top:1px solid var(--hair);font-size:.95rem}
.rows .row:last-child{border-bottom:1px solid var(--hair)}
.row .t{min-width:0;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:var(--serif);font-size:.98rem}
.row .n{color:var(--mut);font-size:.78rem;white-space:nowrap;font-variant-numeric:tabular-nums}
.row .v{font-variant-numeric:tabular-nums;white-space:nowrap;font-weight:500}
.pos{color:var(--pos)}.neg{color:var(--neg)}
.note{font-size:.75rem;color:var(--mut);margin-top:12px}
.badge{display:inline-block;border:1px solid var(--hair);border-radius:4px;padding:1px 8px;font-size:.7rem;letter-spacing:.04em;text-transform:uppercase}
.badge.approve{color:var(--pos);border-color:#d3ecd9}
.badge.reject{color:var(--neg);border-color:#f5d4d4}
.err{background:#fdecec;color:#b91c1c;padding:9px 12px;border-radius:6px;margin-bottom:20px;font-size:.8rem}
.statline{display:flex;gap:26px;padding:18px 0;border-top:1px solid var(--hair);border-bottom:1px solid var(--hair)}
.stat .v{font-family:var(--serif);font-size:1.35rem;font-weight:500;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.stat .k{font-size:.72rem;color:var(--mut);margin-top:2px;white-space:nowrap}
code{font-family:ui-monospace,'SF Mono',Menlo,monospace;font-size:.72rem;color:var(--mut);word-break:break-all}
footer{margin-top:72px;display:flex;gap:20px;font-size:.75rem;color:var(--mut)}
footer a{color:var(--mut)}footer a:hover{color:var(--accent)}

.ic{vertical-align:-2px;color:var(--mut)}
h2 .ic{vertical-align:-1.5px;margin-right:5px}
.k .ic{margin-right:3px}

.ic{color:var(--mut);flex:none}
h2{gap:6px}
h2 .ic{opacity:.75}
.k{gap:4px}
.statline{gap:30px}
.row{padding:14px 0}
.pmline{padding:16px 0}
.what{margin-top:8px;font-size:.82rem;line-height:1.55;color:var(--mut)}
.what .badge{margin-right:6px}
.note{margin-top:10px}

.mv{display:inline-flex;align-items:center;gap:3px;margin-right:10px}
.mini{display:inline-block;width:10px;height:10px;line-height:10px;text-align:center;border-radius:50%;font-size:.58rem;font-weight:600;color:#fff}
.mini.approve{background:var(--pos)}
.mini.reject{background:var(--neg)}
@media (max-width:640px){
  .wrap{padding:40px 16px 64px}
  .statline{gap:18px;flex-wrap:wrap}
}
</style>
</head>
<body>
<div class="wrap">
{db_error && <div class="err">Ledger unreachable — figures may be incomplete.</div>}

<nav class="id"><span class="dot"></span><a href="/">Cash machine</a><a href="/council/">council</a><a href="/history/">history</a> <button class="theme-t" id="themeBtn" type="button" aria-label="Toggle theme">
<svg id="themeIcon" width="15" height="15" viewBox="0 0 15 15" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
<g id="icoSun" style="display:none"><circle cx="7.5" cy="7.5" r="3"/><path d="M7.5 1v1.6M7.5 12.4V14M1 7.5h1.6M12.4 7.5H14M2.9 2.9l1.1 1.1M11 11l1.1 1.1M12.1 2.9L11 4M4 11l-1.1 1.1"/></g>
<g id="icoMoon" style="display:none"><path d="M12.6 9.4A5.4 5.4 0 1 1 5.6 2.4a4.3 4.3 0 0 0 7 7z"/></g>
<g id="icoAuto" style="display:none"><circle cx="7.5" cy="7.5" r="3"/><path d="M7.5 4.5a3 3 0 0 1 0 6z" fill="currentColor" stroke="none"/></g>
</svg>
</button></nav>

<header>
  <h1>Council</h1>
  <p class="mut">Three models judge every thesis before money moves. Majority rules, at least one frontier model required.</p>
</header>

<div class="statline">
  <div class="stat"><div class="v">${tot.toFixed(2)}</div><div class="k"><Icon name="coins" size=11 /> spend</div></div>
  <div class="stat"><div class="v">{costs_daily.length}</div><div class="k"><Icon name="calendar" size=11 /> days</div></div>
</div>

<section>
<h2><Icon name="bar-chart-3" size=12 cls="h2ic" />Calls by day</h2>
<div class="rows">
{costs_daily.map(d=>(<div class="row">
  <span class="t mut">{fmtDate(d.date_utc)}</span>
  <span class="n">{d.run_count} calls</span>
  <span class="v">${d.total_cost_usd.toFixed(2)}</span>
</div>))}
</div>
</section>

<section>
<h2><Icon name="scale" size=12 cls="h2ic" />Verdicts by thesis</h2>
<div class="rows">
{verdictGroups.map(g=>(<div class="row">
  <span class="t"><a href={`/thesis/${g.id}/`}>{/^(REJ|CR)[\d-]|^[A-Z]{1,4} \d{8}/.test(g.title) ? 'Earlier thesis' : g.title}</a></span>
  <span class="n">{g.vs.map(v=>(<span class="mv"><span class={v.verdict === 'APPROVE' ? 'mini approve' : 'mini reject'}>{v.verdict[0]}</span>{v.m}</span>))}</span>
</div>))}
</div>
<p class="note">Confidence and per-call cost are on each thesis page.</p>
</section>

<section>
<h2><Icon name="history" size=12 cls="h2ic" />Recent calls</h2>
<div class="rows">
{runs_recent.map(r=>(<div class="row">
  <span class="t mut">{fmtAgo(r.ts_utc)}</span>
  <span class="n">{modelName(r.model)} · {r.trigger?.startsWith('new-trade') ? 'new trade' : r.trigger?.startsWith('position-review') ? 'position review' : r.trigger?.startsWith('watchlist') ? 'watchlist' : (/\b(REJ|CR)-\d{8}/.test(r.trigger) ? r.trigger.replace(/\b[A-Z]+-\d{8}[^\s]*/,'').trim() || 'new trade' : /^\d{8}$/.test(r.trigger) ? 'new trade' : r.trigger)}</span>
  <span class="v">{money(r.cost_usd)}</span>
</div>))}
</div>
</section>

<footer><a href="/">home</a><a href="/history/">history</a></footer>
</div>
<script is:inline>
(function(){
  var b=document.getElementById('themeBtn'); if(!b) return;
  var modes=['auto','light','dark'];
  var cur=localStorage.getItem('cm-theme')||'auto';
  function apply(p){
    var dark=p==='dark'||(p==='auto'&&matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.setAttribute('data-theme',dark?'dark':'light');
    var sun=document.getElementById('icoSun'),moon=document.getElementById('icoMoon'),auto=document.getElementById('icoAuto');
    if(sun){sun.style.display=p==='light'?'':'none';moon.style.display=p==='dark'?'':'none';auto.style.display=p==='auto'?'':'none';}
  }
  apply(cur);
  b.addEventListener('click',function(){
    cur=modes[(modes.indexOf(cur)+1)%3];
    localStorage.setItem('cm-theme',cur);
    apply(cur);
  });
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change',function(){ if((localStorage.getItem('cm-theme')||'auto')==='auto') apply('auto'); });
})();
</script>
</body></html>
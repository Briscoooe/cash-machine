---
export const prerender = false;
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';
import { fmtDate, fmtAgo } from '../lib/dates.js';
import Icon from '../components/Icon.astro';
let db_error = false;
Astro.response.headers.set('Cache-Control', 'no-store');
let state = {mode:'—', started:'—', wallet_cash:'—', position_value:'—'};
let trades = [], rejected = [], cats = [];
try {
  const db = Astro.locals.runtime.env.DB;
  const q = async (sql) => (await db.prepare(sql).all()).results;
  state = Object.fromEntries((await q('SELECT k,v FROM state')).map(r=>[r.k,r.v]));
  trades = await q('SELECT * FROM trades ORDER BY ts_utc DESC LIMIT 100');
  rejected = await q('SELECT id, ts_utc, thesis, decision, side, my_est_yes, proposed_price, category, counterfactual_pnl, resolved_outcome, market_url FROM rejected ORDER BY ts_utc DESC LIMIT 30');
  cats = await q("SELECT category, COUNT(*) n FROM rejected WHERE category IS NOT NULL GROUP BY category ORDER BY n DESC");
} catch (e) {
  db_error = true;
  console.error('D1 read error', e);
}
const money = (n) => { const x = Number(n); return Number.isFinite(x) ? '$' + x.toFixed(2) : '—'; };
const cfSum = rejected.reduce((a,r)=>a+(r.counterfactual_pnl ?? 0), 0);
const openTrades = trades.filter(t=>t.status==='open');
// live tracking: join open trades with on-chain positions
let chainPos = [];
try {
  const r = await fetch('https://data-api.polymarket.com/positions?user=${Astro.locals.runtime.env.WALLET_ADDRESS}', { signal: AbortSignal.timeout(8000) });
  if (r.ok) chainPos = await r.json();
} catch (e) { console.error('positions fetch failed', e); }
const tracking = openTrades.map(t => {
  const mq = (t.market||'').trim().replace(/\?$/,'').toLowerCase();
  let p = chainPos.find(p => (p.title||'').trim().replace(/\?$/,'').toLowerCase() === mq);
  if (!p) { const kw = mq.split(' ').slice(0,5).join(' '); const cands = chainPos.filter(p => (p.title||'').toLowerCase().includes(kw)); if (cands.length===1) p = cands[0]; }
  if (!p) return { t, live: false };
  const shares = Number(p.size)||0, cur = Number(p.curPrice)||0, cost = Number(t.size_usd)||0;
  const now = shares*cur;
  const pl = now - cost;
  const atRes = shares*1; // full payout if our side wins
  const plWin = atRes - cost;
  return { t, live: true, shares, cur, now, pl, atRes, plWin };
});
const closedTrades = trades.filter(t=>t.status==='closed');
const short = (s) => { if(!s) return ''; let t = s.slice(0,90); return t.charAt(0).toUpperCase()+t.slice(1); };
const slugTitle = (url, fallback) => {
  try {
    let slug = url.split('/event/')[1] || '';
    slug = slug.replace(/-[0-9a-f]{4,}$/,'');
    if(!slug) return fallback;
    let words = slug.split('-').map(w=>{
      if(/^(by|of|in|the|a|an|on|for|and|or|to|at|its|their|from|between|after|before)$/i.test(w)) return w.toLowerCase();
      if(/^(us|uk|dc|gdp|ipo|er|wti|sep|oct|nov|hr|eu|nfl|mlb|nba)$/i.test(w)) return w.toUpperCase();
      if(/^\d+$/.test(w)) return w;
      return w.charAt(0).toUpperCase()+w.slice(1);
    });
    let out = words.join(' ')
      .replace(/\s*Byptptpt\s*/i, ' ')
      .replace(/\s+(by|into|in|of|for)$/,'');
    out = out.replace(/\s+/g,' ').trim();
    return out.charAt(0).toUpperCase()+out.slice(1);
  } catch { return fallback; }
};
---
<html>
<head>
<meta charset="utf-8" />
<script is:inline>
(function(){
  try {
    var pref = new URLSearchParams(location.search).get('theme') || localStorage.getItem('cm-theme') || 'auto';
    var dark = pref === 'dark' || (pref === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
  } catch(e) {}
})();
</script>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Cash Machine</title>
<style is:global>header{margin-bottom:8px}
.stat{min-width:0}
/* theme */
html[data-theme=dark]{--bg:#101013;--fg:#e6e6e9;--mut:#8b8b92;--hair:#26262b;--accent:#8b8bf5;--pos:#3fbf6e;--neg:#e56060}
.k{gap:4px}</style>
</head>
<body>
<div class="wrap">
{db_error && <div class="err">Ledger unreachable — figures may be incomplete.</div>}

<header>
  <SiteNav />
  <h1>Bets on public questions, published in full.</h1>
  <p class="mut">One machine, small sums, every judgment on the record. Started {fmtDate(state.started || '2026-09-11')}.</p>
</header>

<div class="statline">
  <div class="stat"><div class="v">{money(state.wallet_cash)}</div><div class="k"><Icon name="wallet" size=11 /> cash</div></div>
  <div class="stat"><div class="v">{money(openTrades.reduce((a,t)=>a+(t.size_usd??0),0) || state.position_value)}</div><div class="k"><Icon name="layers" size=11 /> committed</div></div>
  <div class="stat"><div class="v">{rejected.length}</div><div class="k"><Icon name="scale" size=11 /> judged</div></div>
  <div class="stat"><div class="v num {cfSum>=0?'pos':'neg'}">{cfSum>=0?'+':''}{money(cfSum)}</div><div class="k"><Icon name="shield-x" size=11 /> refusals</div></div>
</div>

<section>
  <h2><Icon name="layers" size=12 cls="h2ic" />Open positions</h2>
  <div class="rows">
    {openTrades.length === 0
      ? <div class="row mut">None right now</div>
      : tracking.map(({t, live, shares, cur, now, pl, atRes, plWin}) => (
        <div class="row" style="display:block">
          <div style="display:flex;justify-content:space-between;gap:12px">
            <span class="t"><a href={`/trade/${t.id}/`}>{t.market}</a></span>
            <span class="v num">{money(t.size_usd)} <span class="mut">{t.side}</span></span>
          </div>
          {live ? (
            <div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:4px;font-size:.92em">
              <span>Now <b>{money(now)}</b> <span class={pl>=0?'pos':'neg'}>{pl>=0?'+':''}{money(pl)}</span></span>
              <span>Mark <b>{(Number(cur)*100).toFixed(1)}%</b></span>
              <span>Wins → <b>{money(atRes)}</b> <span class="pos">{'+'+money(plWin)}</span></span>
              <span>Loses → <b>$0.00</b> <span class="neg">−{money(t.size_usd)}</span></span>
            </div>
          ) : (
            <div class="mut" style="margin-top:4px">Live quote unavailable</div>
          )}
        </div>
      ))}
  </div>
  <p class="note">Now = mark-to-market. Wins → = payout at resolution if our side wins; loses → $0.</p>
</section>

{closedTrades.length > 0 && <section>
  <h2><Icon name="check" size=11 cls="h2ic" />Closed positions</h2>
  <div class="rows">
    {closedTrades.map(t=>(
      <div class="row">
        <span class="t"><a href={`/trade/${t.id}/`}>{t.market}</a></span>
        <span class={`v num ${t.realized_pl>=0?'pos':'neg'}`}>{t.realized_pl>=0?'+':''}{money(t.realized_pl)}</span>
      </div>
    ))}
  </div>
  <p class="note">Realized P/L per closed position. <a href="/history/">Full record →</a></p>
</section>}

<section>
  <h2><Icon name="gavel" size=12 cls="h2ic" />Recent judgments</h2>
  <div class="rows">
    {rejected.slice(0,12).map(r=>(
      <div class="row">
        <span class="t"><a href={`/thesis/${r.id}/`}>{slugTitle(r.market_url, short(r.thesis))}</a></span>
        <span class="n">{r.category}</span>
      </div>
    ))}
  </div>
  <p class="note">Every judgment is kept. <a href="/history/">Full record →</a></p>
</section>

<section>
  <h2><Icon name="shield-x" size=12 cls="h2ic" />Why the machine says no</h2>
  <div class="rows">
    {cats.map(c=>(
      <div class="row">
        <span class="t mut">{c.category}</span>
        <span class="v num">{c.n}</span>
      </div>
    ))}
  </div>
</section>


</div>

<SiteFooter />
</body></html>
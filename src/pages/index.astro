---
export const prerender = false;
let db_error = false;
Astro.response.headers.set('Cache-Control', 'no-store');
let state = {mode:'—', started:'—', wallet_cash:'—', position_value:'—'};
let trades = [], rejected = [], cats = [];
try {
  const db = Astro.locals.runtime.env.DB;
  const q = async (sql) => (await db.prepare(sql).all()).results;
  state = Object.fromEntries((await q('SELECT k,v FROM state')).map(r=>[r.k,r.v]));
  trades = await q('SELECT * FROM trades ORDER BY ts_utc DESC LIMIT 100');
  rejected = await q('SELECT id, ts_utc, thesis, decision, side, my_est_yes, proposed_price, category, counterfactual_pnl, resolved_outcome, market_url FROM rejected ORDER BY ts_utc DESC LIMIT 30');
  cats = await q("SELECT category, COUNT(*) n FROM rejected WHERE category IS NOT NULL GROUP BY category ORDER BY n DESC");
} catch (e) {
  db_error = true;
  console.error('D1 read error', e);
}
const money = (n) => { const x = Number(n); return Number.isFinite(x) ? '$' + x.toFixed(2) : '—'; };
const cfSum = rejected.reduce((a,r)=>a+(r.counterfactual_pnl ?? 0), 0);
const openTrades = trades.filter(t=>t.status==='open');
const short = (s) => { if(!s) return ''; let t = s.slice(0,90); return t.charAt(0).toUpperCase()+t.slice(1); };
const slugTitle = (url, fallback) => {
  try {
    let slug = url.split('/event/')[1] || '';
    slug = slug.replace(/-[0-9a-f]{4,}$/,'');
    if(!slug) return fallback;
    let words = slug.split('-').map(w=>{
      if(/^(by|of|in|the|a|an|on|for|and|or|to|at|its|their|from|between|after|before)$/i.test(w)) return w.toLowerCase();
      if(/^(us|uk|dc|gdp|ipo|er|wti|sep|oct|nov|hr|eu|nfl|mlb|nba)$/i.test(w)) return w.toUpperCase();
      if(/^\d+$/.test(w)) return w;
      return w.charAt(0).toUpperCase()+w.slice(1);
    });
    let out = words.join(' ')
      .replace(/\s*Byptptpt\s*/i, ' ')
      .replace(/\s+(by|into|in|of|for)$/,'');
    out = out.replace(/\s+/g,' ').trim();
    return out.charAt(0).toUpperCase()+out.slice(1);
  } catch { return fallback; }
};
---
<html>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" /><link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600&display=swap" rel="stylesheet">
<title>Cash Machine</title>
<style>
:root{
  --bg:#fbfbfa; --fg:#18181b; --mut:#8e8e93; --hair:#e8e8e6;
  --accent:#4f46e5;
--serif:'Newsreader',Georgia,serif;}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);margin:0;padding:0;
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Inter,sans-serif;
  font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
.wrap{max-width:560px;margin:0 auto;padding:64px 20px 96px}
a{color:inherit;text-decoration:none}
a:hover{color:var(--accent)}
header{margin-bottom:8px}
.id{font-size:.8rem;font-weight:600;letter-spacing:.02em;display:flex;align-items:center;gap:8px}
.id .dot{width:6px;height:6px;border-radius:50%;background:var(--accent)}
.id small{color:var(--mut);font-weight:400;margin-left:10px;font-size:.75rem}
h1{font-family:var(--serif);font-size:1.35rem;font-weight:500;margin:26px 0 2px;letter-spacing:-.01em}
.mut{color:var(--mut);font-size:.82rem}
p.prose{font-family:var(--serif);font-size:1.02rem;line-height:1.6}
section{margin-top:40px}
h2{font-size:.72rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase;
  color:var(--mut);margin:0 0 10px}
.rows{display:flex;flex-direction:column}
.row{display:flex;justify-content:space-between;align-items:baseline;gap:14px;
  padding:13px 0;border-top:1px solid var(--hair);font-size:.9rem}
.rows .row:last-child{border-bottom:1px solid var(--hair)}
.row .t{min-width:0;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:var(--serif);font-size:.98rem}
.row .n{color:var(--mut);font-size:.78rem;white-space:nowrap;font-variant-numeric:tabular-nums}
.row .v{font-variant-numeric:tabular-nums;white-space:nowrap;font-weight:500}
.pos{color:#16a34a}
.neg{color:#dc2626}
.statline{display:flex;gap:26px;padding:18px 0;border-top:1px solid var(--hair);border-bottom:1px solid var(--hair)}
.stat{min-width:0}
.stat .v{font-family:var(--serif);font-size:1.35rem;font-weight:500;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.stat .k{font-size:.72rem;color:var(--mut);margin-top:2px}
.stat .k{white-space:nowrap}
.note{font-size:.75rem;color:var(--mut);margin-top:12px}
footer{margin-top:72px;display:flex;gap:20px;font-size:.75rem;color:var(--mut)}
footer a{color:var(--mut)}
footer a:hover{color:var(--accent)}
.err{background:#fdecec;color:#b91c1c;padding:9px 12px;border-radius:6px;margin-bottom:20px;font-size:.8rem}
@media (max-width:640px){
  .wrap{padding:40px 16px 64px}
  .statline{gap:18px;flex-wrap:wrap}
}
</style>
</head>
<body>
<div class="wrap">
{db_error && <div class="err">Ledger unreachable — figures may be incomplete.</div>}

<header>
  <div class="id"><span class="dot"></span>Cash machine <small>live</small></div>
  <h1>Bets on public questions, published in full.</h1>
  <p class="mut">One machine, small sums, every judgment on the record. Started {(state.started||'2026-09-11').slice(0,10)}.</p>
</header>

<div class="statline">
  <div class="stat"><div class="v">{money(state.wallet_cash)}</div><div class="k">free cash</div></div>
  <div class="stat"><div class="v">{money(state.position_value)}</div><div class="k">in positions</div></div>
  <div class="stat"><div class="v">{rejected.length}</div><div class="k">judged</div></div>
  <div class="stat"><div class="v num {cfSum>=0?'pos':'neg'}">{cfSum>=0?'+':''}{money(cfSum)}</div><div class="k">refusal p/l</div></div>
</div>

<section>
  <h2>Open positions</h2>
  <div class="rows">
    {openTrades.length === 0
      ? <div class="row mut">None right now</div>
      : openTrades.map(t=>(
        <div class="row">
          <span class="t"><a href={`/trade/${t.id}/`}>{t.market}</a></span>
          <span class="v num">{money(t.size_usd)} <span class="mut">{t.side}</span></span>
        </div>
      ))}
  </div>
  <p class="note">Held to resolution. No early exits.</p>
</section>

<section>
  <h2>Recent judgments</h2>
  <div class="rows">
    {rejected.slice(0,12).map(r=>(
      <div class="row">
        <span class="t"><a href={`/thesis/${r.id}/`}>{slugTitle(r.market_url, short(r.thesis))}</a></span>
        <span class="n">{r.category}</span>
      </div>
    ))}
  </div>
  <p class="note">Every judgment is kept. <a href="/history/">Full record →</a></p>
</section>

<section>
  <h2>Why the machine says no</h2>
  <div class="rows">
    {cats.map(c=>(
      <div class="row">
        <span class="t mut">{c.category}</span>
        <span class="v num">{c.n}</span>
      </div>
    ))}
  </div>
</section>

<footer>
  <a href="/history/">history</a>
  <a href="/council/">council</a>
</footer>
</div>
</body></html>
---
export const prerender = false;
import { fmtDate, fmtAgo } from '../lib/dates.js';
import Icon from '../components/Icon.astro';
let db_error = false;
Astro.response.headers.set('Cache-Control', 'no-store');
let balance_history = [], calibration = [], rejected = [], avg = {b:null,n:0};
try {
  const db = Astro.locals.runtime.env.DB;
  const q = async (sql) => (await db.prepare(sql).all()).results;
  balance_history = await q('SELECT * FROM balance_history ORDER BY date_utc DESC LIMIT 60');
  calibration = await q('SELECT market, my_est, market_price, outcome, brier, resolved_at FROM calibration WHERE outcome IS NOT NULL ORDER BY resolved_at DESC');
  avg = (await q('SELECT AVG(brier) b, COUNT(*) n FROM calibration WHERE brier IS NOT NULL'))[0];
  rejected = await q('SELECT id, thesis, resolved_outcome, my_est_yes, postmortem FROM rejected WHERE postmortem IS NOT NULL ORDER BY ts_utc DESC LIMIT 60');
} catch (e) {
  db_error = true;
}
const money = (n) => { const x = Number(n); return Number.isFinite(x) ? '$' + x.toFixed(2) : '—'; };
const slugTitle = (url, fallback) => {
  try {
    let slug = (url || '').split('/event/')[1] || '';
    slug = slug.replace(/-[0-9a-f]{4,}$/,'');
    if(!slug) return fallback;
    let words = slug.split('-').map(w=>{
      if(/^(by|of|in|the|a|an|on|for|and|or|to|at|its|their|from|between|after|before)$/i.test(w)) return w.toLowerCase();
      if(/^(us|uk|dc|gdp|ipo|er|wti|sep|oct|nov|hr|eu)$/i.test(w)) return w.toUpperCase();
      if(/^\d+$/.test(w)) return w;
      return w.charAt(0).toUpperCase()+w.slice(1);
    });
    let out = words.join(' ').replace(/\s*Byptptpt\s*/i,' ').replace(/\s+(by|into|in|of|for)$/,'');
    out = out.replace(/\s+/g,' ').trim();
    return out.charAt(0).toUpperCase()+out.slice(1);
  } catch { return fallback; }
};
const short = (s) => { if(!s) return ''; let t = s.slice(0,90); return t.charAt(0).toUpperCase()+t.slice(1); };
---
<html>
<head>
<meta charset="utf-8"/>
<script is:inline>
(function(){
  try {
    var pref = new URLSearchParams(location.search).get('theme') || localStorage.getItem('cm-theme') || 'auto';
    var dark = pref === 'dark' || (pref === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
  } catch(e) {}
})();
</script>
<style is:global>
:root{--pos:#0f8a3d;--neg:#d64545}
html[data-theme=dark]{
  --bg:#101013;--fg:#e6e6e9;--mut:#8b8b92;--hair:#26262b;--accent:#8b8bf5;
  --pos:#3fbf6e;--neg:#e56060;
}
html[data-theme=dark] body{background:var(--bg)}
.theme-t{background:none;border:1px solid var(--hair);border-radius:6px;color:var(--mut);
  font:inherit;font-size:.72rem;padding:3px 9px;cursor:pointer;letter-spacing:.03em}
.theme-t:hover{color:var(--fg);border-color:var(--mut)}
</style>

<meta name="viewport" content="width=device-width,initial-scale=1"/><link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600&display=swap" rel="stylesheet">
<title>History — Cash Machine</title>
<style>
:root{--bg:#fbfbfa;--fg:#18181b;--mut:#8e8e93;--hair:#e8e8e6;--accent:#4f46e5;--pos:#16a34a;--neg:#dc2626--serif:'Newsreader',Georgia,serif;}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);margin:0;padding:0;
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Inter,sans-serif;
  font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
.wrap{max-width:640px;margin:0 auto;padding:64px 20px 96px}
a{color:inherit;text-decoration:none}
a:hover{color:var(--accent)}
.id{font-size:.8rem;font-weight:600;letter-spacing:.02em;display:flex;align-items:center;gap:8px;margin-bottom:26px}
.id .dot{width:6px;height:6px;border-radius:50%;background:var(--accent)}
.id small{color:var(--mut);font-weight:400;margin-left:10px;font-size:.75rem}
nav.id a{margin-right:14px;color:var(--mut)}
nav.id a:hover{color:var(--accent)}
h1{font-family:var(--serif);font-size:1.35rem;font-weight:500;letter-spacing:0;margin:0 0 2px;letter-spacing:-.01em}
.mut{color:var(--mut);font-size:.82rem}
p.prose{font-family:var(--serif);font-size:1.02rem;line-height:1.6}
section{margin-top:40px}
h2{font-size:.72rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);margin:0 0 10px}
.rows{display:flex;flex-direction:column}
.row{display:flex;justify-content:space-between;align-items:baseline;gap:14px;padding:13px 0;border-top:1px solid var(--hair);font-size:.95rem}
.rows .row:last-child{border-bottom:1px solid var(--hair)}
.row .t{min-width:0;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:var(--serif);font-size:.98rem}
.row .n{color:var(--mut);font-size:.78rem;white-space:nowrap;font-variant-numeric:tabular-nums}
.row .v{font-variant-numeric:tabular-nums;white-space:nowrap;font-weight:500}
.pos{color:var(--pos)}.neg{color:var(--neg)}
.note{font-size:.75rem;color:var(--mut);margin-top:12px}
.err{background:#fdecec;color:#b91c1c;padding:9px 12px;border-radius:6px;margin-bottom:20px;font-size:.8rem}
.statline{display:flex;gap:26px;padding:18px 0;border-top:1px solid var(--hair);border-bottom:1px solid var(--hair)}
.stat .v{font-family:var(--serif);font-size:1.35rem;font-weight:500;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.stat .k{font-size:.72rem;color:var(--mut);margin-top:2px;white-space:nowrap}
.pmline{border-left:2px solid var(--hair);padding:2px 0 2px 14px;font-size:.95rem;margin:14px 0;font-family:var(--serif)}
.pmline b{font-weight:600}
.pmline .what{color:var(--mut);font-size:.82rem;margin-top:2px}
footer{margin-top:72px;display:flex;gap:20px;font-size:.75rem;color:var(--mut)}
footer a{color:var(--mut)}footer a:hover{color:var(--accent)}

.ic{vertical-align:-2px;color:var(--mut)}
h2 .ic{vertical-align:-1.5px;margin-right:5px}
.k .ic{margin-right:3px}

.ic{color:var(--mut);flex:none}
h2{gap:6px}
h2 .ic{opacity:.75}
.k{gap:4px}
.statline{gap:30px}
.row{padding:14px 0}
.pmline{padding:16px 0}
.what{margin-top:10px;font-size:.82rem;line-height:1.6;color:var(--mut)}
.what .badge{margin-bottom:6px}
.what .badge{display:inline-block;margin-bottom:6px}
.note{margin-top:10px}
@media (max-width:640px){
  .wrap{padding:40px 16px 64px}
  .statline{gap:18px;flex-wrap:wrap}
}
</style>
</head>
<body>
<div class="wrap">
{db_error && <div class="err">Ledger unreachable — figures may be incomplete.</div>}

<nav class="id"><span class="dot"></span><a href="/">Cash machine</a><a href="/council/">council</a><a href="/history/">history</a> <button class="theme-t" id="themeBtn" type="button" aria-label="Toggle theme">
<svg id="themeIcon" width="15" height="15" viewBox="0 0 15 15" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
<g id="icoSun" style="display:none"><circle cx="7.5" cy="7.5" r="3"/><path d="M7.5 1v1.6M7.5 12.4V14M1 7.5h1.6M12.4 7.5H14M2.9 2.9l1.1 1.1M11 11l1.1 1.1M12.1 2.9L11 4M4 11l-1.1 1.1"/></g>
<g id="icoMoon" style="display:none"><path d="M12.6 9.4A5.4 5.4 0 1 1 5.6 2.4a4.3 4.3 0 0 0 7 7z"/></g>
<g id="icoAuto" style="display:none"><circle cx="7.5" cy="7.5" r="3"/><path d="M7.5 4.5a3 3 0 0 1 0 6z" fill="currentColor" stroke="none"/></g>
</svg>
</button></nav>

<header>
  <h1>History</h1>
  <p class="mut">Balance, calibration, and what the machine learned.</p>
</header>

<div class="statline">
  <div class="stat"><div class="v">{avg?.b!=null?avg.b.toFixed(3):'—'}</div><div class="k"><Icon name="target" size=11 /> accuracy</div></div>
  <div class="stat"><div class="v">{avg?.n||0}</div><div class="k"><Icon name="check-circle-2" size=11 /> resolved</div></div>
</div>
<p class="note">Brier score = mean squared error of estimates vs outcomes. 0 is perfect, 0.25 is coin-flip level. Lower is better.</p>

<section>
<h2><Icon name="chart-line" size=12 cls="h2ic" />Balance over time</h2>
<div class="rows">
{balance_history.map((b,idx)=>{
  const prev = balance_history[idx+1];
  const d = (prev && b.total_value!=null && prev.total_value!=null) ? Number(b.total_value)-Number(prev.total_value) : null;
  const cls = d==null ? '' : (d>=0 ? ' pos' : ' neg');
  return (<div class="row">
  <span class="t mut">{fmtDate(b.date_utc)}</span>
  <span class="v">{money(b.balance)}</span>
  <span class="n{cls}">{d!=null ? ((d>=0?'+':'−')+money(Math.abs(d))+' · ') : ''}{b.total_value!=null?money(b.total_value):'—'} total · {b.open_positions??'—'} open</span>
</div>);
})}
</div>
</section>

<section>
<h2><Icon name="target" size=12 cls="h2ic" />Calibration</h2>
{calibration.length === 0 ? <p class="mut">No resolved markets yet — scores appear as tracked markets resolve</p> :
<div class="rows">
{calibration.map(c=>(<div class="row">
  <span class="t">{c.market?.slice?.(0,70)}</span>
  <span class="n">est {(Number(c.my_est)*100).toFixed(0)}% vs {(Number(c.market_price)*100).toFixed(0)}% · {c.outcome}</span>
  <span class="v">{c.brier?.toFixed?.(3)}</span>
</div>))}
</div>}
</section>

<section>
<h2><Icon name="notebook-pen" size=12 cls="h2ic" />Post-mortems</h2>
{rejected.length === 0 ? <p class="mut">None yet</p> :
rejected.map(r=>{
  let parts = [];
  try { const pm = JSON.parse(r.postmortem); parts = (pm.verdicts||[]).map(v=>({model:v.model, verdict:v.verdict, reasoning:v.reasoning})); } catch { parts = [{reasoning:String(r.postmortem).slice(0,240)}]; }
  return (<div class="pmline">
    <b>{short(r.thesis)}</b> → resolved {r.resolved_outcome} · {fmtAgo(r.resolved_at)}
    {parts.map(p=>(<div class="what"><span class="badge {p.verdict === 'APPROVE' ? 'approve' : 'reject'}">{p.verdict || '—'}</span>{p.reasoning}</div>))}
  </div>);
})}
</section>

<footer><a href="/">home</a><a href="/council/">council</a></footer>
</div>
<script is:inline>
(function(){
  var b=document.getElementById('themeBtn'); if(!b) return;
  var modes=['auto','light','dark'];
  var cur=localStorage.getItem('cm-theme')||'auto';
  function apply(p){
    var dark=p==='dark'||(p==='auto'&&matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.setAttribute('data-theme',dark?'dark':'light');
    var sun=document.getElementById('icoSun'),moon=document.getElementById('icoMoon'),auto=document.getElementById('icoAuto');
    if(sun){sun.style.display=p==='light'?'':'none';moon.style.display=p==='dark'?'':'none';auto.style.display=p==='auto'?'':'none';}
  }
  apply(cur);
  b.addEventListener('click',function(){
    cur=modes[(modes.indexOf(cur)+1)%3];
    localStorage.setItem('cm-theme',cur);
    apply(cur);
  });
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change',function(){ if((localStorage.getItem('cm-theme')||'auto')==='auto') apply('auto'); });
})();
</script>
</body></html>